# Agent Core local configuration template
# Copy this file to .env and edit only the settings required for this machine.
# Never commit the real .env or any credential-bearing values.
# Agent Core auto-detects its project root from the launcher/module location.
# For project-owned path overrides, prefer relative paths, @project/..., or <PROJECT_ROOT>/...
# instead of drive-specific absolute paths. Default-style absolute paths from a previous
# machine/root are rebased to the current project root during startup.
# See docs/PATH-GOVERNANCE.md. Hardcoded project-owned paths are rejected by npm run path:check.
# AGENT_CORE_PROJECT_ROOT=

# Core listener / persistence
AGENT_CORE_HOST=127.0.0.1
AGENT_CORE_PORT=8765
AGENT_CORE_DATA_DIR=runtime\bridge-auth
AGENT_CORE_MEMORY_DIR=runtime\memory
# Opt-in Memory cognitive upgrades (all disabled by default): all | none | comma list of
# adaptiveFusion,contradictionResolution,remConsolidation,epistemicConfidence,forgettingCurve,tiering,multiHop,selfRepair,secretMasking
# AGENT_CORE_MEMORY_COGNITIVE=
AGENT_CORE_MCP_PROTOCOL_MODE=dual

# HTTP / OAuth identity
# Leave public/protected-resource URLs blank for local-only operation.
AGENT_CORE_PUBLIC_BASE_URL=
AGENT_CORE_OAUTH_PROTECTED_RESOURCE_URL=
AGENT_CORE_TRUST_PROXY=false
AGENT_CORE_MCP_ALLOWED_ORIGINS=

# Optional Cloudflare Workers AI embeddings.
# Configure ACCOUNT_ID + API_TOKEN + MODEL together, or leave all three unset.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_EMBEDDING_MODEL=@cf/google/embeddinggemma-300m
# CLOUDFLARE_EMBEDDING_DIMENSIONS=768

# Agent Core internal machine-control configuration
AGENT_CORE_RDC_CONFIG_DIR=runtime\rdc
# AGENT_CORE_PUPPETEER_CACHE_DIR=runtime\rdc\puppeteer-cache

# Optional content-size limits (bytes)
# AGENT_CORE_URL_TEXT_MAX_BYTES=16777216
# AGENT_CORE_URL_BINARY_MAX_BYTES=67108864
# AGENT_CORE_INTERNAL_TEXT_MAX_BYTES=33554432
# AGENT_CORE_PDF_URL_MAX_BYTES=

# Code Intelligence / Grafel (enabled by default)
# AGENT_CORE_CODE_INTELLIGENCE_ENABLED=true
# AGENT_CORE_CODE_INTELLIGENCE_RUNTIME_DIR=runtime\grafel
# AGENT_CORE_GRAFEL_BINARY=runtime\grafel\bin\grafel.exe
# AGENT_CORE_CODE_INTELLIGENCE_GROUP=agent-core
# AGENT_CORE_CODE_INTELLIGENCE_REPO_SLUG=agent-core
# AGENT_CORE_CODE_INTELLIGENCE_STARTUP_TIMEOUT_MS=30000
# AGENT_CORE_CODE_INTELLIGENCE_CALL_TIMEOUT_MS=15000
# AGENT_CORE_GRAFEL_MAX_RSS_BUDGET_MB=
# AGENT_CORE_GRAFEL_RELOAD_DEBOUNCE_MS=
# AGENT_CORE_GRAFEL_BM25_IDLE_MS=
# AGENT_CORE_GRAFEL_GROUP_IDLE_MS=0
# AGENT_CORE_GRAFEL_GROUP_KEEP_READER=true
# AGENT_CORE_GRAFEL_GROUP_RSS_BUDGET_MB=0
# AGENT_CORE_GRAFEL_GROUP_ALGO_DEBOUNCE=

# Learning (enabled by default)
# AGENT_CORE_LEARNING_ENABLED=true
# AGENT_CORE_LEARNING_STATE_DIR=runtime\learning
# AGENT_CORE_LEARNING_REVIEW_INTERVAL=10
# AGENT_CORE_LEARNING_CURATOR_INTERVAL_HOURS=168

# Semantic IDE / LSP (enabled by default)
# AGENT_CORE_SEMANTIC_IDE_ENABLED=true
# AGENT_CORE_SEMANTIC_IDE_RUNTIME_DIR=runtime\semantic-ide
# AGENT_CORE_SEMANTIC_IDE_STARTUP_TIMEOUT_MS=30000
# AGENT_CORE_SEMANTIC_IDE_CALL_TIMEOUT_MS=15000
# AGENT_CORE_SEMANTIC_IDE_TYPESCRIPT_SERVER=
# AGENT_CORE_SEMANTIC_IDE_TYPESCRIPT_TSSERVER=
# AGENT_CORE_SEMANTIC_IDE_SERVERS_FILE=
# AGENT_CORE_SEMANTIC_IDE_PYTHON_SERVER=
# AGENT_CORE_SEMANTIC_IDE_CSHARP_SERVER=
# AGENT_CORE_SEMANTIC_IDE_DOTNET=
# AGENT_CORE_SEMANTIC_IDE_POWERSHELL_EDITOR_SERVICES=

# Game Mode / phone (enabled by default)
# AGENT_CORE_PHONE_ENABLED=true
# AGENT_CORE_PHONE_TRANSPORT=gateway
# AGENT_CORE_PHONE_DEVICE_ID=
# AGENT_CORE_PHONE_GATEWAY_URL=
# AGENT_CORE_PHONE_GATEWAY_TOKEN=
# AGENT_CORE_ADB_PATH=
# AGENT_CORE_ADB_SERIAL=
# AGENT_CORE_PHONE_WIDTH=1080
# AGENT_CORE_PHONE_HEIGHT=2392
# AGENT_CORE_PHONE_DATA_DIR=runtime\phone

# Optional launcher/runtime overrides
# AGENT_CORE_NODE_EXE=
# Native Agent Runtime / Capability Parity
# Existing installations remain conservative unless capability policy is explicitly changed.
# AGENT_CORE_AI_ENABLED=true
# AGENT_CORE_AI_PROVIDER_ORDER=atria,gonka,openrouter,anthropic
# Anthropic Messages API; blank keys keep the route absent. Default model: claude-sonnet-5-5.
ANTHROPIC_API_KEY_01=
ANTHROPIC_API_KEY_02=
ANTHROPIC_API_KEY_03=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Highest reasoning effort used when a caller gave none (low|medium|high|xhigh|max, default max). The provider
# picks the highest level the model supports up to this ceiling; "off" or "auto" sends no effort.
# ANTHROPIC_REASONING_EFFORT=max
# ANTHROPIC_PROMPT_CACHING=true
# ANTHROPIC_WORKSPACE_ID=
# ANTHROPIC_CONTEXT_WINDOW_TOKENS=
# ANTHROPIC_MAX_OUTPUT_TOKENS=
# Declared capacity for a pinned model whose /models entry has no limits (gonkarouter lists only the id).
# Both values are required; each key still has to pass a live tool probe before use. Same names exist for ATRIA_ and OPENROUTER_.
# GONKA_CONTEXT_WINDOW_TOKENS=
# GONKA_MAX_OUTPUT_TOKENS=
# AGENT_CORE_AI_MAX_PROVIDER_ATTEMPTS=6
# AGENT_CORE_AI_REQUEST_TIMEOUT_MS=60000
# AGENT_CORE_AI_MAX_TOOL_ITERATIONS=60
# Goal-mode window: a goal turn parks as resumable at the end of each window instead of failing.
# AGENT_CORE_AI_GOAL_MAX_TOOL_ITERATIONS=200
# Native runtime state (runtime/agent-runtime/state.json): an unchanged task reuses its earlier normalization instead of being
# re-validated on every update, which kept each update at a few seconds once hundreds of tasks were stored. Set to off to disable.
# AGENT_CORE_RUNTIME_NORMALIZE_CACHE=on
# Native context compaction (digest of older chat messages and of the middle of a long turn). On by default; off|0|false|no disables it.
# AGENT_CORE_AI_COMPACTION=on
# AGENT_CORE_AI_ALLOWED_TOOLS=get_config
# Operator profile stays inside the project; resolved from the module root, never cwd or a request.
AGENT_CORE_AI_PROFILE_ENABLED=false
# AGENT_CORE_AI_PROFILE_ROOT=@project/runtime/agent-runtime/profile
# AGENT_CORE_AI_CAPABILITY_POLICY=explicit
# AGENT_CORE_AI_ALLOWED_CAPABILITIES=

# Agent Core-native Web Research
# Search provider fallback order: Exa -> Parallel -> Firecrawl -> Jina.
# Reader/extraction fallback: Jina Reader -> Parallel Extract -> Firecrawl Scrape.
# Jina Reader can open public URLs without a key; search requires at least one provider key.
# AGENT_CORE_WEB_RESEARCH_ENABLED=true
# AGENT_CORE_WEB_RESEARCH_TIMEOUT_MS=30000
# EXA_API_KEY=
# PARALLEL_API_KEY=
# FIRECRAWL_API_KEY=
# JINA_API_KEY=

# Cloudflare Tunnel public access (docs/Cloudflare-Tunnel.md)
# Public hostname only; Agent Core derives https://<hostname>/mcp as an additional OAuth identity (default identity stays AGENT_CORE_OAUTH_PROTECTED_RESOURCE_URL).
# CLOUDFLARE_TUNNEL_HOSTNAME=agent-core.example.com
# Tunnel token for scripts\windows\Start-Cloudflare-Tunnel.ps1.
# CLOUDFLARE_TUNNEL_TOKEN=
# Optional extra public MCP resource URLs, plain https, comma separated.
# AGENT_CORE_OAUTH_ADDITIONAL_RESOURCE_URLS=
