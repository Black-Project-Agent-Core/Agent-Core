AGENT_CORE_HOST=127.0.0.1
AGENT_CORE_PORT=8765
AGENT_CORE_DATA_DIR=runtime\data
AGENT_CORE_LOG_DIR=runtime\logs
AGENT_CORE_CAPABILITY_DIR=capabilities
AGENT_CORE_ALLOWED_ROOTS=.
# An Obsidian-compatible Markdown vault is the canonical local store.
# Normal work requires a healthy vault, Graphify index and direct Supabase memory.
AGENT_CORE_MEMORY_HARD_LIFECYCLE_MODE=enforce
# AGENT_CORE_MEMORY_VAULT_ROOT=runtime\memory\vault
# AGENT_CORE_MEMORY_RG_PATH=
# AGENT_CORE_MEMORY_GRAPHIFY_PATH=
# AGENT_CORE_MEMORY_PYTHON_PATH=
# Direct Supabase memory: apply supabase/migrations/20260909_direct_memory.sql first.
# Copy these three settings into .env, fill URL/key, then change enabled to true.
# Until configured, health and recovery remain available but substantive work is blocked.
AGENT_CORE_MEMORY_SUPABASE_DIRECT_ENABLED=false
AGENT_CORE_MEMORY_SUPABASE_URL=
AGENT_CORE_MEMORY_SUPABASE_SECRET_KEY=
# Optional request timeout, in milliseconds (default 15000):
# AGENT_CORE_MEMORY_SUPABASE_TIMEOUT_MS=15000
# Separate encrypted Supabase Second Memory backup (see docs/deterministic-memory.md):
# AGENT_CORE_MEMORY_SUPABASE_PUBLISHABLE_KEY=
# File-native state roots for the non-memory subsystems
# AGENT_CORE_EXECUTION_STATE_ROOT=runtime\execution\state
# AGENT_CORE_OPERATOR_DIRECTIVES_STATE_ROOT=runtime\operator-directives\state
# Optional machine-specific overrides when auto-discovery is not enough:
# AGENT_CORE_NODE_EXE=C:\Program Files\nodejs\node.exe
# AGENT_CORE_TUNNEL_EXE=E:\Portable\Agent-Core\tunnel-client\tunnel-client.exe
