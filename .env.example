AGENT_CORE_HOST=127.0.0.1
AGENT_CORE_PORT=8765
AGENT_CORE_DATA_DIR=runtime\data
AGENT_CORE_LOG_DIR=runtime\logs
AGENT_CORE_CAPABILITY_DIR=capabilities
AGENT_CORE_ALLOWED_ROOTS=.
# Optional machine-specific overrides when auto-discovery is not enough:
# AGENT_CORE_NODE_EXE=C:\Program Files\nodejs\node.exe
# AGENT_CORE_TUNNEL_EXE=F:\Apps\OpenAI-Tunnel-Client\v0.0.10\tunnel-client.exe

# ============================================================
# SubAgentCore — JOE-owned worker team
# Shared memory is enforced by code through Agent Core MemoryService.
# Add additional keys manually by continuing the numeric suffix: _3, _4, ...
# Never rename a live key value to rotate it; the runtime selects slots by number.
# ============================================================
SUBAGENTCORE_ENABLED=true
SUBAGENTCORE_REQUEST_TIMEOUT_MS=180000

# OpenRouter
SUBAGENTCORE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SUBAGENTCORE_OPENROUTER_DEFAULT_MODEL=
SUBAGENTCORE_OPENROUTER_API_KEY_1=
SUBAGENTCORE_OPENROUTER_API_KEY_2=

# NVIDIA NIM / API Catalog
SUBAGENTCORE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
SUBAGENTCORE_NVIDIA_DEFAULT_MODEL=
SUBAGENTCORE_NVIDIA_API_KEY_1=
SUBAGENTCORE_NVIDIA_API_KEY_2=

# OpenHands Cloud — provider/runtime path, not SubAgentCore identity
SUBAGENTCORE_OPENHANDS_BASE_URL=https://app.all-hands.dev/api/v1
SUBAGENTCORE_OPENHANDS_DEFAULT_MODEL=
SUBAGENTCORE_OPENHANDS_API_KEY_1=
SUBAGENTCORE_OPENHANDS_API_KEY_2=

# Worker routing. MODEL blank => provider DEFAULT_MODEL. KEY_SLOT=auto => rotate eligible numbered slots.
SUBAGENTCORE_ASTRA_PROVIDER=openrouter
SUBAGENTCORE_ASTRA_MODEL=
SUBAGENTCORE_ASTRA_KEY_SLOT=auto

SUBAGENTCORE_FORGE_PROVIDER=openhands
SUBAGENTCORE_FORGE_MODEL=
SUBAGENTCORE_FORGE_KEY_SLOT=auto

SUBAGENTCORE_SENTINEL_PROVIDER=nvidia
SUBAGENTCORE_SENTINEL_MODEL=
SUBAGENTCORE_SENTINEL_KEY_SLOT=auto

SUBAGENTCORE_SCRIBE_PROVIDER=openrouter
SUBAGENTCORE_SCRIBE_MODEL=
SUBAGENTCORE_SCRIBE_KEY_SLOT=auto
