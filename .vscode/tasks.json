{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GPT Supervisor",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/.devcontainer/scripts/gpt-supervisor-terminal.py"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "Codespace 24/7 heartbeat",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.devcontainer/scripts/keepalive-terminal.sh"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      }
    }
  ]
}
