{
  "name": "agent-core",
  "version": "0.13.0",
  "private": true,
  "description": "Local authenticated RDC-compatible MCP machine bridge",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "semantic:smoke": "node scripts/semantic-ide-smoke.mjs",
    "verify:mcp-external": "node scripts/verify/mcp-external-acceptance.mjs",
    "test": "vitest run",
    "start": "node dist/index.js",
    "verify": "npm run build && npm test",
    "recovery:audit": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/windows/Recover-Agent-Core.ps1 -Mode Audit",
    "recovery:repair": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/windows/Recover-Agent-Core.ps1 -Mode Repair",
    "release:intent": "node scripts/release/create-intent.mjs",
    "release:plan": "node scripts/release/release-plan.mjs",
    "release:sync-version": "node scripts/release/sync-version.mjs",
    "release:apply": "node scripts/release/apply-release.mjs",
    "release:baseline": "node scripts/release/current-line-baseline.mjs",
    "release:check-intent": "node scripts/release/check-release-intent.mjs",
    "release:package": "node scripts/release/package-release.mjs",
    "release:snapshot-plan": "node scripts/release/snapshot-plan.mjs",
    "release:snapshot-package": "node scripts/release/snapshot-package.mjs",
    "release:pre-enter": "node scripts/release/pre-enter.mjs",
    "release:pre-exit": "node scripts/release/pre-exit.mjs",
    "release:pre-package": "node scripts/release/pre-package.mjs",
    "release:compat": "node scripts/release/release-compat.mjs",
    "learning:evaluate-retrieval": "node scripts/learning/evaluate-retrieval.mjs",
    "learning:verify-retrieval": "node scripts/learning/verify-retrieval.mjs"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opendocsg/pdf2md": "^0.2.2",
    "@puppeteer/browsers": "^3.2.2",
    "@vscode/ripgrep": "^1.15.9",
    "cross-fetch": "^4.1.0",
    "exceljs": "^4.4.0",
    "fastest-levenshtein": "^1.0.16",
    "isbinaryfile": "^5.0.4",
    "md-to-pdf": "^5.2.5",
    "modern-tar": "0.8.5",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.2.0",
    "proper-lockfile": "^4.1.2",
    "sharp": "0.34.5",
    "typescript-language-server": "6.0.0",
    "typescript-lsp-runtime": "npm:typescript@6.0.3",
    "unpdf": "1.4.0",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@changesets/parse": "^1.0.0",
    "@types/node": "^24.13.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/yauzl": "3.4.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "legacyRepository": "https://github.com/Black-Project-Agent-Core/Agent-Core"
}
