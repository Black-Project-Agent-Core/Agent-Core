{
  "name": "agent-core",
  "version": "0.6.0",
  "private": true,
  "description": "Local-first authenticated Agent Core MCP control plane",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "sync:capabilities": "npm run build && node scripts/sync-capabilities.mjs",
    "build:plugin": "npm run build && node scripts/build-plugin-package.mjs",
    "acceptance:github": "npm run build && node scripts/github-live-acceptance.mjs",
    "check:brand": "node scripts/check-agent-core-brand.mjs",
    "benchmark:memory": "npm run build && node scripts/benchmark-memory.mjs",
    "benchmark:codespace-memory": "npm run build && npm run build:codespace && node scripts/benchmark-codespace-shared-memory.mjs",
    "benchmark:execution": "npm run build && node scripts/benchmark-execution.mjs",
    "quality:report": "npm run build && node scripts/evaluate-quality.mjs",
    "quality:gate": "npm run build && node scripts/evaluate-quality.mjs --gate",
    "verify": "npm run check:brand && npm run build && npm run build:codespace && npm test",
    "verify:release": "npm run verify && npm run quality:gate && node scripts/release/check-release.mjs && node scripts/release/check-doc-links.mjs",
    "certify:core:prepublish": "node scripts/release/certify-core.mjs --prepublish",
    "certify:core": "node scripts/release/certify-core.mjs",
    "package:release": "node scripts/release/build-release.mjs",
    "codespace:bootstrap": "bash scripts/codespace/bootstrap.sh --phase manual",
    "codespace:repair": "bash scripts/codespace/ensure-running.sh --repair --phase manual",
    "codespace:connection": "bash scripts/codespace/show-connection.sh",
    "codespace:gateway:update": "bash scripts/codespace/update-stable-gateway.sh",
    "codespace:gateway:deploy": "bash scripts/codespace/deploy-stable-gateway.sh",
    "codespace:anchor:set": "bash scripts/codespace/set-anchor-backend.sh",
    "codespace:anchor:discover": "bash scripts/codespace/discover-anchor-backend.sh",
    "build:codespace": "npm --prefix plugin/codespace ci && npm --prefix plugin/codespace run build",
    "verify:stable-parity": "node scripts/release/check-stable-parity.mjs",
    "build:observatory": "npm --prefix SubProject/Memory-Observatory ci && npm --prefix SubProject/Memory-Observatory run build",
    "verify:observatory:root": "vitest run --no-file-parallelism tests/memory-activity.test.ts tests/memory-observatory-projection.test.ts tests/http-memory-observatory.test.ts tests/memory-observatory-sidecar-contract.test.ts tests/memory-observatory-shadow.acceptance.test.ts tests/memory-observatory-resilience.acceptance.test.ts tests/memory-observatory-benchmark.test.ts tests/memory-observatory-cross-codespace.acceptance.test.ts tests/memory-observatory-memory-correctness.acceptance.test.ts tests/codespace-memory-observatory-lifecycle.test.ts",
    "verify:observatory": "npm --prefix SubProject/Memory-Observatory ci && npm --prefix SubProject/Memory-Observatory run verify && npm --prefix SubProject/Memory-Observatory run test:e2e && npm run verify:observatory:root",
    "observatory:shadow": "npm --prefix SubProject/Memory-Observatory ci && npm --prefix SubProject/Memory-Observatory run build && npm --prefix SubProject/Memory-Observatory run start"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Black-Project-Agent-Core/Agent-Core.git"
  }
}
