{
  "manifest_version": 3,
  "name": "Agent Core Browser Bridge",
  "version": "0.1.0",
  "description": "Connect the selected existing browser tab to Agent Core's guarded browser control.",
  "permissions": ["debugger", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "Agent Core Browser Bridge", "default_popup": "popup.html" }
}
