+    AvailabilityState, CredentialEvent, CredentialEventKind, CredentialProfile, CredentialProvider,
+    FailureClass, KeyId, KeySummary, LifecycleState, LimitReset, ProtectedBlob, UsageObservation,
+};
+
+const SCHEMA_VERSION: i64 = 4;
+const MAX_USAGE_OBSERVATIONS_PER_KEY: i64 = 64;
+
+#[derive(Debug, Error)]
+pub enum StoreError {
+    #[error("vault database I/O failed")]
+    Io(#[from] std::io::Error),
+    #[error("vault database operation failed")]
+    Sqlite(#[source] rusqlite::Error),
+    #[error("existing vault database is corrupt")]
+    CorruptExisting,
+    #[error("vault schema version {0} is newer than this application")]
+    UnsupportedSchema(i64),
+    #[error("vault contains an invalid stored value: {0}")]
+    InvalidStoredValue(&'static str),
+    #[error("vault key was not found")]
+    KeyNotFound,
+}
+
+#[derive(Clone, Debug)]
+pub struct NewStoredKey {
+    pub key_id: KeyId,
+    pub slot_index: i64,
