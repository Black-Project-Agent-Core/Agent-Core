+        let key_id = KeyId("decrypt-failure-key".to_owned());
+        let mut store = VaultStore::open(&path).unwrap();
+        let slot_index = store.reserve_next_slot_index().unwrap();
+        store
+            .insert_key(NewStoredKey {
