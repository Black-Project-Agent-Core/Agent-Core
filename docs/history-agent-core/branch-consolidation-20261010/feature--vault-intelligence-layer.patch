@@ -0,0 +1,25 @@
+import { invoke } from '@tauri-apps/api/core';
+import type { CredentialEvent, KeySummary } from './vault-types';
+
+export const listKeys = () => invoke<KeySummary[]>('vault_list_openrouter_keys');
+export const listEvents = (limit: number) => invoke<CredentialEvent[]>('vault_list_credential_events', { limit });
+
+export const addKey = (secret: string, label: string) =>
+  invoke<KeySummary>('vault_add_openrouter_key', {
+    request: { secret, label },
+  });
+
+export const setKeyEnabled = (keyId: string, enabled: boolean) =>
+  invoke<KeySummary>('vault_set_enabled', {
+    request: { keyId, enabled },
+  });
+
+export const deleteKey = (keyId: string) =>
+  invoke<boolean>('vault_delete_key', {
+    request: { keyId },
+  });
+
+export const validateKey = (keyId: string) =>
+  invoke<KeySummary>('vault_validate_key', {
+    request: { keyId },
+  });
diff --git a/SubProject/Agent-Code/src/features/vault/vault-types.ts b/SubProject/Agent-Code/src/features/vault/vault-types.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0a36ab0987c2ec508477c79e1a298b2784a2967f
--- /dev/null
+++ b/SubProject/Agent-Code/src/features/vault/vault-types.ts
@@ -0,0 +1,48 @@
+export type LifecycleState = 'ENABLED' | 'DISABLED' | 'INVALID' | 'QUARANTINED';
+export type AvailabilityState = 'UNVERIFIED' | 'READY' | 'WARNING' | 'COOLDOWN' | 'EXHAUSTED';
+export type FailureClass =
+  | 'AUTH_INVALID'
+  | 'PERMISSION_BLOCKED'
+  | 'CREDIT_BLOCKED'
+  | 'RATE_LIMITED'
+  | 'REQUEST_INVALID'
+  | 'PROVIDER_TRANSIENT'
+  | 'UNKNOWN';
+
+export type CredentialEventKind =
+  | 'CREDENTIAL_ADDED'
+  | 'CREDENTIAL_REMOVED'
+  | 'CREDENTIAL_HEALTHY'
+  | 'CREDENTIAL_WARNING'
+  | 'CREDENTIAL_COOLDOWN'
+  | 'CREDENTIAL_RECOVERED'
+  | 'CREDENTIAL_EXPIRED'
+  | 'CREDENTIAL_SELECTED';
+
+export type CredentialEvent = {
+  event_id: number;
+  kind: CredentialEventKind;
+  key_id: string;
+  occurred_at_utc_ms: number;
+};
+
+export type KeySummary = {
+  key_id: string;
+  slot_index: number;
+  label: string;
+  masked_suffix: string;
+  lifecycle_state: LifecycleState;
+  availability_state: AvailabilityState;
+  cooldown_until_utc_ms: number | null;
+  consecutive_failures: number;
+  last_success_at_utc_ms: number | null;
+  last_failure_at_utc_ms: number | null;
+  last_failure_class: FailureClass | null;
+  last_probe_at_utc_ms: number | null;
+  limit_value: number | null;
+  limit_remaining: number | null;
+  limit_reset: 'DAILY' | 'WEEKLY' | 'MONTHLY' | null;
+  usage_daily: number | null;
+  is_free_tier: boolean | null;
+  expires_at_utc_ms: number | null;
+};
