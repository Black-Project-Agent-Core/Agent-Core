+            .unwrap_err();
+        assert!(matches!(error, ManagerError::DuplicateCredential));
+        assert!(!format!("{error}").contains(canary));
+        assert!(!format!("{error:?}").contains(canary));
+    }
+
+    #[test]
+    fn checksum_mismatch_is_quarantined_before_unprotect_and_is_never_selectable() {
+        let dir = tempfile::tempdir().unwrap();
