+  color: var(--text-primary);
+  font: inherit;
+  font-size: 12px;
+}
+
+.vault-field input:focus {
+  border-color: #444951;
+  box-shadow: 0 0 0 1px rgb(86 185 255 / 6%);
+}
+
+.vault-field input::placeholder {
+  color: #60646b;
+}
+
+.vault-import-button,
+.vault-secondary-button,
+.vault-icon-danger {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border: 1px solid var(--border-strong);
+  border-radius: 9px;
+  font-size: 11.5px;
+  font-weight: 560;
+}
+
+.vault-import-button {
+  height: 40px;
+  gap: 7px;
+  padding: 0 15px;
+  background: #e5e5e2;
+  color: #18191b;
+}
+
+.vault-import-button:disabled,
+.vault-secondary-button:disabled,
+.vault-icon-danger:disabled,
+.vault-field input:disabled {
+  cursor: default;
+  opacity: 0.45;
+}
+
+.vault-notice,
+.vault-empty,
+.vault-native-unavailable,
+.vault-list {
+  width: min(900px, 100%);
+  margin-inline: auto;
+}
+
+.vault-notice {
+  margin-top: 0;
+  margin-bottom: 14px;
+  color: #8b8f96;
+  font-size: 11px;
+}
+
+.vault-empty,
+.vault-native-unavailable {
+  margin-top: 24px;
+  padding: 22px;
+  border: 1px solid #292c31;
+  border-radius: 12px;
+  background: #17191c;
+  color: #777b82;
+  font-size: 12px;
+}
+
+.vault-native-unavailable {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.vault-native-unavailable strong {
+  color: #a9acb1;
+  font-weight: 560;
+}
+
+.vault-list {
+  display: flex;
+  margin-top: 24px;
+  flex-direction: column;
+  border-top: 1px solid #292c31;
+}
+
+.vault-key-row {
+  display: flex;
+  min-height: 76px;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  padding: 15px 2px;
+  border-bottom: 1px solid #292c31;
+}
+
+.vault-key-identity {
+  min-width: 0;
+}
+
+.vault-key-title-line {
+  display: flex;
+  align-items: baseline;
+  gap: 10px;
+}
+
+.vault-key-title-line strong {
+  overflow: hidden;
+  color: #dededb;
+  font-size: 12.5px;
+  font-weight: 560;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.vault-key-title-line code {
+  color: #6f737a;
+  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  font-size: 10.5px;
+}
+
+.vault-badges {
+  display: flex;
+  margin-top: 8px;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+.vault-badge {
+  padding: 3px 6px;
+  border: 1px solid #31343a;
+  border-radius: 6px;
+  background: #1b1d21;
+  color: #858990;
+  font-size: 9px;
+  font-weight: 680;
+  letter-spacing: 0.045em;
+}
+
+.vault-badge-ready,
+.vault-badge-enabled {
+  color: #a8b5ab;
+}
+
+.vault-badge-invalid,
+.vault-badge-quarantined,
+.vault-badge-exhausted {
+  color: #bb9292;
+}
+
+.vault-badge-warning,
+.vault-badge-cooldown {
+  color: #b5a98b;
+}
+
+.vault-key-actions {
+  display: flex;
+  flex: 0 0 auto;
+  align-items: center;
+  gap: 7px;
+}
+
+.vault-secondary-button {
+  height: 32px;
+  padding: 0 11px;
+  background: #1d1f23;
+  color: #a4a7ad;
+}
+
+.vault-icon-danger {
+  width: 32px;
+  height: 32px;
+  background: transparent;
+  color: #777b82;
+}
+
+.vault-icon-danger:hover {
+  color: #c09191;
+}
+
+.vault-activity {
+  width: min(900px, 100%);
+  margin: 30px auto 0;
+  padding-top: 22px;
+  border-top: 1px solid #292c31;
+}
+
+.vault-activity-header {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 16px;
+  margin-bottom: 10px;
+}
+
+.vault-activity-header h2 {
+  margin: 0;
+  color: #dededb;
+  font-size: 14px;
+  font-weight: 560;
+}
+
+.vault-activity-header span,
+.vault-activity-empty {
+  color: #70747b;
+  font-size: 10.5px;
+}
+
+.vault-activity-list {
+  display: flex;
+  flex-direction: column;
+}
+
+.vault-activity-row {
+  display: flex;
+  min-height: 48px;
+  align-items: center;
+  justify-content: space-between;
+  gap: 18px;
+  padding: 10px 0;
+  border-bottom: 1px solid #24272c;
+}
+
+.vault-activity-row > div {
+  display: flex;
+  min-width: 0;
+  flex-direction: column;
+  gap: 3px;
+}
+
+.vault-activity-row strong {
+  color: #a9acb1;
+  font-size: 10px;
+  font-weight: 650;
+  letter-spacing: 0.035em;
+}
+
+.vault-activity-row span,
+.vault-activity-row time {
+  color: #686c73;
+  font-size: 10px;
+}
+
+.vault-activity-row time {
+  flex: 0 0 auto;
+}
+
+@media (max-width: 900px) {
+  .vault-surface {
+    padding-inline: 22px;
+  }
+
+  .vault-import {
+    grid-template-columns: 1fr;
+  }
+
+  .vault-import-button {
+    width: fit-content;
+  }
+}
