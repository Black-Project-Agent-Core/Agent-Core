+++ b/SubProject/Agent-Code/src-tauri/crates/credential-core/tests/usage.rs
@@ -0,0 +1,293 @@
+use agent_code_credential_core::{
+    analyze_usage, AvailabilityState, KeyId, LifecycleState, NewStoredKey, ProtectedBlob,
+    UsageAnalysisError, UsageObservation, VaultStore, EWMA_ALPHA,
+    MIN_PREDICTION_WARNING_CONFIDENCE, WARNING_EXHAUSTION_HORIZON_MS, WARNING_QUOTA_RATIO,
+};
+
+fn sample(key: &str, at_ms: i64, limit: Option<f64>, remaining: Option<f64>) -> UsageObservation {
+    UsageObservation {
+        key_id: KeyId(key.to_owned()),
+        observed_at_utc_ms: at_ms,
+        limit_value: limit,
+        limit_remaining: remaining,
+        usage_daily: None,
+        availability_state: if remaining == Some(0.0) {
+            AvailabilityState::Exhausted
+        } else {
+            AvailabilityState::Ready
+        },
+    }
+}
+
+fn stored_key(key: &str) -> NewStoredKey {
+    NewStoredKey {
+        key_id: KeyId(key.to_owned()),
+        slot_index: 0,
+        label: "Usage Key".to_owned(),
+        masked_suffix: "••••1234".to_owned(),
+        protected_blob: ProtectedBlob::new(vec![1, 2, 3, 4]),
+        lifecycle_state: LifecycleState::Enabled,
+        availability_state: AvailabilityState::Ready,
+        cooldown_until_utc_ms: None,
+        consecutive_failures: 0,
+        last_success_at_utc_ms: None,
+        last_failure_at_utc_ms: None,
+        last_failure_class: None,
+        last_probe_at_utc_ms: None,
+        limit_value: Some(100.0),
+        limit_remaining: Some(100.0),
+        limit_reset: None,
+        usage_daily: None,
+        is_free_tier: Some(false),
+        expires_at_utc_ms: None,
+        created_at_utc_ms: 0,
+        updated_at_utc_ms: 0,
+    }
+}
+
+#[test]
+fn one_sample_keeps_exhaustion_prediction_unknown_but_scores_known_quota() {
+    let analysis = analyze_usage(&[sample("key-1", 1_000, Some(100.0), Some(80.0))]).unwrap();
+
+    assert_eq!(analysis.ewma_burn_rate_per_ms, None);
+    assert_eq!(analysis.time_to_exhaustion_ms, None);
+    assert_eq!(analysis.quota_ratio, Some(0.8));
+    assert_eq!(analysis.quota_score, 80.0);
+    assert_eq!(analysis.confidence_score, 25.0);
+    assert!(!analysis.warning);
+}
+
+#[test]
+fn deterministic_ewma_and_time_to_exhaustion_use_named_policy_constants() {
+    assert_eq!(EWMA_ALPHA, 0.5);
+    assert_eq!(WARNING_QUOTA_RATIO, 0.15);
+    assert_eq!(WARNING_EXHAUSTION_HORIZON_MS, 6 * 60 * 60 * 1_000);
+    assert_eq!(MIN_PREDICTION_WARNING_CONFIDENCE, 75.0);
+
+    let observations = [
+        sample("key-1", 0, Some(100.0), Some(100.0)),
+        sample("key-1", 10_000, Some(100.0), Some(90.0)),
+        sample("key-1", 20_000, Some(100.0), Some(70.0)),
+    ];
+    let analysis = analyze_usage(&observations).unwrap();
+
+    // interval rates: 0.001 then 0.002 units/ms; alpha 0.5 => 0.0015 units/ms
+    assert_eq!(analysis.ewma_burn_rate_per_ms, Some(0.0015));
+    assert_eq!(analysis.time_to_exhaustion_ms, Some(46_667));
+    assert_eq!(analysis.confidence_score, 75.0);
+    assert!(analysis.warning);
+}
+
+#[test]
+fn one_burn_interval_is_not_enough_confidence_for_prediction_only_warning() {
+    let observations = [
+        sample("key-1", 600, Some(100.0), Some(80.0)),
+        sample("key-1", 800, Some(100.0), Some(75.0)),
+    ];
+    let analysis = analyze_usage(&observations).unwrap();
+
+    assert_eq!(analysis.confidence_score, 50.0);
+    assert!(analysis.time_to_exhaustion_ms.is_some());
+    assert!(!analysis.warning);
+}
+
+#[test]
+fn low_quota_warns_even_when_consumption_rate_is_not_yet_known() {
+    let analysis = analyze_usage(&[sample("key-1", 1_000, Some(100.0), Some(15.0))]).unwrap();
+    assert_eq!(analysis.time_to_exhaustion_ms, None);
+    assert!(analysis.warning);
+}
+
+#[test]
+fn provider_quota_reset_discards_stale_burn_rate_until_new_evidence_arrives() {
+    let observations = [
+        sample("key-1", 0, Some(100.0), Some(50.0)),
+        sample("key-1", 10_000, Some(100.0), Some(40.0)),
+        sample("key-1", 20_000, Some(100.0), Some(100.0)),
+    ];
+    let analysis = analyze_usage(&observations).unwrap();
+
+    assert_eq!(analysis.ewma_burn_rate_per_ms, None);
+    assert_eq!(analysis.time_to_exhaustion_ms, None);
+    assert_eq!(analysis.quota_ratio, Some(1.0));
+    assert_eq!(analysis.confidence_score, 25.0);
+    assert!(!analysis.warning);
+}
+
+#[test]
+fn limit_without_remaining_has_zero_prediction_confidence() {
+    let analysis = analyze_usage(&[sample("key-1", 1_000, Some(100.0), None)]).unwrap();
+
+    assert_eq!(analysis.quota_ratio, None);
+    assert_eq!(analysis.ewma_burn_rate_per_ms, None);
+    assert_eq!(analysis.time_to_exhaustion_ms, None);
+    assert_eq!(analysis.quota_score, 50.0);
+    assert_eq!(analysis.confidence_score, 0.0);
+    assert!(!analysis.warning);
+}
+
+#[test]
+fn unknown_or_unlimited_quota_stays_unknown_instead_of_inventing_prediction() {
+    let observations = [
+        sample("key-1", 0, None, None),
+        sample("key-1", 10_000, None, None),
+    ];
+    let analysis = analyze_usage(&observations).unwrap();
+
+    assert_eq!(analysis.quota_ratio, None);
+    assert_eq!(analysis.ewma_burn_rate_per_ms, None);
+    assert_eq!(analysis.time_to_exhaustion_ms, None);
+    assert_eq!(analysis.quota_score, 50.0);
+    assert_eq!(analysis.confidence_score, 0.0);
+    assert!(!analysis.warning);
+}
+
+#[test]
+fn no_usage_samples_is_explicitly_unknown() {
+    assert!(matches!(
+        analyze_usage(&[]),
+        Err(UsageAnalysisError::NoObservations)
+    ));
+}
+
+#[test]
+fn provider_limit_change_resets_old_burn_evidence() {
+    let observations = [
+        sample("key-1", 0, Some(100.0), Some(50.0)),
+        sample("key-1", 10_000, Some(100.0), Some(40.0)),
+        sample("key-1", 20_000, Some(200.0), Some(80.0)),
+    ];
+    let analysis = analyze_usage(&observations).unwrap();
+
+    assert_eq!(analysis.ewma_burn_rate_per_ms, None);
+    assert_eq!(analysis.time_to_exhaustion_ms, None);
+    assert_eq!(analysis.quota_ratio, Some(0.4));
+    assert_eq!(analysis.confidence_score, 25.0);
+    assert!(!analysis.warning);
+}
+
+#[test]
+fn extreme_burn_spike_stays_finite_and_deterministic() {
+    let observations = [
+        sample("key-1", 0, Some(1_000_000.0), Some(1_000_000.0)),
+        sample("key-1", 1, Some(1_000_000.0), Some(1.0)),
+    ];
+    let analysis = analyze_usage(&observations).unwrap();
+
+    assert_eq!(analysis.ewma_burn_rate_per_ms, Some(999_999.0));
+    assert_eq!(analysis.time_to_exhaustion_ms, Some(1));
+    assert!(analysis.warning);
+    assert!(analysis.quota_score.is_finite());
+    assert!(analysis.confidence_score.is_finite());
+}
+
+#[test]
+fn twenty_key_mixed_quota_pool_isolatedly_classifies_each_key() {
+    let mut warning_count = 0usize;
+    for index in 0..20 {
+        let remaining = index as f64 * 5.0;
+        let analysis = analyze_usage(&[sample(
+            &format!("key-{index}"),
+            1_000,
+            Some(100.0),
+            Some(remaining),
+        )])
+        .unwrap();
+        assert_eq!(analysis.key_id, KeyId(format!("key-{index}")));
+        assert!((analysis.quota_score - remaining).abs() < 1e-9);
+        if analysis.warning {
+            warning_count += 1;
+        }
+    }
+    assert_eq!(warning_count, 4);
+}
+
+#[test]
+fn invalid_or_non_monotonic_observations_are_rejected() {
+    let duplicate_time = [
+        sample("key-1", 1_000, Some(100.0), Some(80.0)),
+        sample("key-1", 1_000, Some(100.0), Some(70.0)),
+    ];
+    assert!(matches!(
+        analyze_usage(&duplicate_time),
+        Err(UsageAnalysisError::NonMonotonicTimestamp)
+    ));
+
+    let impossible_remaining = [sample("key-1", 1_000, Some(100.0), Some(101.0))];
+    assert!(matches!(
+        analyze_usage(&impossible_remaining),
+        Err(UsageAnalysisError::InvalidObservation("limit_remaining"))
+    ));
+
+    let mixed_keys = [
+        sample("key-1", 1_000, Some(100.0), Some(80.0)),
+        sample("key-2", 2_000, Some(100.0), Some(70.0)),
+    ];
+    assert!(matches!(
+        analyze_usage(&mixed_keys),
+        Err(UsageAnalysisError::MixedCredentialIds)
+    ));
+}
+
+#[test]
+fn zero_remaining_is_exhausted_and_warns_without_division_edge_cases() {
+    let analysis = analyze_usage(&[
+        sample("key-1", 0, Some(10.0), Some(2.0)),
+        sample("key-1", 1_000, Some(10.0), Some(0.0)),
+    ])
+    .unwrap();
+
+    assert_eq!(analysis.quota_ratio, Some(0.0));
+    assert_eq!(analysis.quota_score, 0.0);
+    assert_eq!(analysis.time_to_exhaustion_ms, Some(0));
+    assert!(analysis.warning);
+}
+
+#[test]
+fn usage_observations_are_bounded_to_64_per_key_and_survive_restart() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("vault.db");
+    let key_id = KeyId("key-1".to_owned());
+
+    {
+        let mut store = VaultStore::open(&path).unwrap();
+        store.insert_key(stored_key("key-1")).unwrap();
+        for index in 0..70i64 {
+            store
+                .append_usage_observation(&sample(
+                    "key-1",
+                    1_000 + index,
+                    Some(100.0),
+                    Some(100.0 - index as f64),
+                ))
+                .unwrap();
+        }
+
+        let observations = store.list_usage_observations(&key_id).unwrap();
+        assert_eq!(observations.len(), 64);
+        assert_eq!(observations.first().unwrap().observed_at_utc_ms, 1_006);
+        assert_eq!(observations.last().unwrap().observed_at_utc_ms, 1_069);
+    }
+
+    let store = VaultStore::open(&path).unwrap();
+    let observations = store.list_usage_observations(&key_id).unwrap();
+    assert_eq!(observations.len(), 64);
+    assert_eq!(observations.first().unwrap().observed_at_utc_ms, 1_006);
+    assert_eq!(observations.last().unwrap().observed_at_utc_ms, 1_069);
+}
+
+#[test]
+fn deleting_a_key_cascades_its_usage_observations() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("vault.db");
+    let key_id = KeyId("key-1".to_owned());
+    let mut store = VaultStore::open(&path).unwrap();
+    store.insert_key(stored_key("key-1")).unwrap();
+    store
+        .append_usage_observation(&sample("key-1", 1_000, Some(100.0), Some(90.0)))
+        .unwrap();
+    assert_eq!(store.list_usage_observations(&key_id).unwrap().len(), 1);
+
+    assert!(store.delete_key(&key_id).unwrap());
+    assert!(store.list_usage_observations(&key_id).unwrap().is_empty());
+}
diff --git a/SubProject/Agent-Code/src-tauri/src/credential/commands.rs b/SubProject/Agent-Code/src-tauri/src/credential/commands.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0c4c1beca52e591a513cb3ead74bfa1e04df6390
--- /dev/null
+++ b/SubProject/Agent-Code/src-tauri/src/credential/commands.rs
@@ -0,0 +1,278 @@
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use agent_code_credential_core::{
+    run_synthetic_rotation_self_test, CredentialEvent, KeyId, KeySummary, ManagerError,
+    OpenRouterProbeClient, OpenRouterValidationError, ProtectError, RotationSnapshot, SecretBytes,
+    SecretProtector, SecretValidationError, StoreError, SyntheticRotationReport,
+};
+use serde::{Deserialize, Serialize};
+use tauri::State;
+use uuid::Uuid;
+use zeroize::Zeroize;
+
+use super::dpapi::DpapiProtector;
+use super::state::CredentialAppState;
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AddOpenRouterKeyRequest {
+    pub secret: String,
+    pub label: String,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct SetEnabledRequest {
+    pub key_id: String,
+    pub enabled: bool,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct DeleteKeyRequest {
+    pub key_id: String,
+}
+
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ValidateKeyRequest {
+    pub key_id: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct VaultCommandError {
+    pub code: String,
+}
+
+impl VaultCommandError {
+    fn new(code: &'static str) -> Self {
+        Self {
+            code: code.to_owned(),
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct NativeVaultSelfTestReport {
+    pub passed: bool,
+    pub error_class: Option<String>,
+}
+
+#[tauri::command]
+pub fn vault_add_openrouter_key(
+    state: State<'_, CredentialAppState>,
+    request: AddOpenRouterKeyRequest,
+) -> Result<KeySummary, VaultCommandError> {
+    let AddOpenRouterKeyRequest {
+        mut secret,
+        label,
+    } = request;
+    let moved_secret = std::mem::take(&mut secret);
+    let parsed = SecretBytes::parse_import(moved_secret).map_err(map_secret_error);
+    secret.zeroize();
+    let parsed = parsed?;
+    state
+        .manager
+        .add_openrouter_key(parsed, label, now_utc_ms()?)
+        .map_err(map_manager_error)
+}
+
+#[tauri::command]
+pub fn vault_list_openrouter_keys(
+    state: State<'_, CredentialAppState>,
+) -> Result<Vec<KeySummary>, VaultCommandError> {
+    state.manager.list_summaries().map_err(map_manager_error)
+}
+
+#[tauri::command]
+pub fn vault_list_credential_events(
+    state: State<'_, CredentialAppState>,
+    limit: usize,
+) -> Result<Vec<CredentialEvent>, VaultCommandError> {
+    state
+        .manager
+        .list_credential_events(limit)
+        .map_err(map_manager_error)
+}
+
+#[tauri::command]
+pub fn vault_set_enabled(
+    state: State<'_, CredentialAppState>,
+    request: SetEnabledRequest,
+) -> Result<KeySummary, VaultCommandError> {
+    state
+        .manager
+        .set_enabled(&KeyId(request.key_id), request.enabled, now_utc_ms()?)
+        .map_err(map_manager_error)
+}
+
+#[tauri::command]
+pub fn vault_delete_key(
+    state: State<'_, CredentialAppState>,
+    request: DeleteKeyRequest,
+) -> Result<bool, VaultCommandError> {
+    state
+        .manager
+        .delete_key(&KeyId(request.key_id), now_utc_ms()?)
+        .map_err(map_manager_error)
+}
+
+
+#[tauri::command]
+pub async fn vault_validate_key(
+    state: State<'_, CredentialAppState>,
+    request: ValidateKeyRequest,
+) -> Result<KeySummary, VaultCommandError> {
+    let manager = std::sync::Arc::clone(&state.manager);
+    let key_id = KeyId(request.key_id);
+    let now_ms = now_utc_ms()?;
+    tauri::async_runtime::spawn_blocking(move || {
+        let client = OpenRouterProbeClient::new().map_err(map_openrouter_error)?;
+        manager
+            .validate_openrouter_key(&key_id, &client, now_ms)
+            .map_err(map_openrouter_error)
+    })
+    .await
+    .map_err(|_| VaultCommandError::new("INTERNAL_ERROR"))?
+}
+
+#[tauri::command]
+pub fn vault_run_native_self_test() -> NativeVaultSelfTestReport {
+    run_dpapi_self_test()
+}
+
+#[tauri::command]
+pub fn rotation_get_snapshot(
+    state: State<'_, CredentialAppState>,
+) -> Result<RotationSnapshot, VaultCommandError> {
+    state
+        .manager
+        .rotation_snapshot()
+        .map_err(|_| VaultCommandError::new("VAULT_CORRUPT"))
+}
+
+#[tauri::command]
+pub fn rotation_run_synthetic_self_test() -> SyntheticRotationReport {
+    run_synthetic_rotation_self_test()
+}
+
+fn run_dpapi_self_test() -> NativeVaultSelfTestReport {
+    let mut canary = format!(
+        "sk-or-v1-SYNTHETIC_DPAPI_SELFTEST_{}",
+        Uuid::new_v4().simple()
+    );
+    let moved_canary = std::mem::take(&mut canary);
+    let secret = match SecretBytes::parse_import(moved_canary) {
+        Ok(secret) => secret,
+        Err(_) => {
+            canary.zeroize();
+            return failed_self_test("INVALID_INPUT");
+        }
+    };
+    canary.zeroize();
+
+    let protector = DpapiProtector;
+    let protected = match protector.protect(&secret) {
+        Ok(protected) => protected,
+        Err(_) => return failed_self_test("PROTECTION_FAILED"),
+    };
+    if !protected.verify_checksum() {
+        return failed_self_test("PROTECTION_FAILED");
+    }
+    let contains_plaintext = secret.expose_bytes(|plaintext| {
+        protected
+            .as_bytes()
+            .windows(plaintext.len())
+            .any(|window| window == plaintext)
+    });
+    if contains_plaintext {
+        return failed_self_test("PROTECTION_FAILED");
+    }
+    let recovered = match protector.unprotect(&protected) {
+        Ok(recovered) => recovered,
+        Err(_) => return failed_self_test("PROTECTION_FAILED"),
+    };
+    if !recovered.ct_eq(&secret) {
+        return failed_self_test("PROTECTION_FAILED");
+    }
+
+    NativeVaultSelfTestReport {
+        passed: true,
+        error_class: None,
+    }
+}
+
+fn failed_self_test(code: &'static str) -> NativeVaultSelfTestReport {
+    NativeVaultSelfTestReport {
+        passed: false,
+        error_class: Some(code.to_owned()),
+    }
+}
+
+fn now_utc_ms() -> Result<i64, VaultCommandError> {
+    let duration = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|_| VaultCommandError::new("INTERNAL_ERROR"))?;
+    i64::try_from(duration.as_millis()).map_err(|_| VaultCommandError::new("INTERNAL_ERROR"))
+}
+
+fn map_secret_error(_error: SecretValidationError) -> VaultCommandError {
+    VaultCommandError::new("INVALID_INPUT")
+}
+
+fn map_manager_error(error: ManagerError) -> VaultCommandError {
+    match error {
+        ManagerError::DuplicateCredential => VaultCommandError::new("DUPLICATE_CREDENTIAL"),
+        ManagerError::InvalidLabel => VaultCommandError::new("INVALID_INPUT"),
+        ManagerError::KeyNotFound => VaultCommandError::new("KEY_NOT_FOUND"),
+        ManagerError::KeyInUse => VaultCommandError::new("KEY_BUSY"),
+        ManagerError::Protect(error) => map_protect_error(error),
+        ManagerError::Store(error) => map_store_error(error),
+        ManagerError::ProtectedRecordUnavailable | ManagerError::StateUnavailable => {
+            VaultCommandError::new("VAULT_CORRUPT")
+        }
+    }
+}
+
+fn map_protect_error(error: ProtectError) -> VaultCommandError {
+    match error {
+        ProtectError::UnsupportedPlatform => VaultCommandError::new("UNSUPPORTED_PLATFORM"),
+        ProtectError::ProtectFailed | ProtectError::UnprotectFailed | ProtectError::IntegrityFailed => {
+            VaultCommandError::new("PROTECTION_FAILED")
+        }
+    }
+}
+
+
+fn map_openrouter_error(error: OpenRouterValidationError) -> VaultCommandError {
+    match error {
+        OpenRouterValidationError::KeyNotFound => VaultCommandError::new("KEY_NOT_FOUND"),
+        OpenRouterValidationError::ProtectedCredentialUnavailable => {
+            VaultCommandError::new("PROTECTION_FAILED")
+        }
+        OpenRouterValidationError::ProbeUnavailable => {
+            VaultCommandError::new("PROBE_UNAVAILABLE")
+        }
+        OpenRouterValidationError::ProbeMalformed => VaultCommandError::new("PROBE_MALFORMED"),
+        OpenRouterValidationError::Store(_) | OpenRouterValidationError::StateUnavailable => {
+            VaultCommandError::new("VAULT_CORRUPT")
+        }
+        OpenRouterValidationError::TimeOverflow => VaultCommandError::new("INTERNAL_ERROR"),
+        OpenRouterValidationError::UsageIntelligenceUnavailable => {
+            VaultCommandError::new("USAGE_INTELLIGENCE_UNAVAILABLE")
+        }
+    }
+}
+
+fn map_store_error(error: StoreError) -> VaultCommandError {
+    match error {
+        StoreError::KeyNotFound => VaultCommandError::new("KEY_NOT_FOUND"),
+        StoreError::CorruptExisting
+        | StoreError::UnsupportedSchema(_)
+        | StoreError::InvalidStoredValue(_)
+        | StoreError::Sqlite(_)
+        | StoreError::Io(_) => VaultCommandError::new("VAULT_CORRUPT"),
+    }
+}
diff --git a/SubProject/Agent-Code/src-tauri/src/credential/dpapi.rs b/SubProject/Agent-Code/src-tauri/src/credential/dpapi.rs
new file mode 100644
index 0000000000000000000000000000000000000000..46da4d2b15aea0c7d86064e950f391c8e03ce7a9
--- /dev/null
+++ b/SubProject/Agent-Code/src-tauri/src/credential/dpapi.rs
@@ -0,0 +1,101 @@
+use agent_code_credential_core::{ProtectError, ProtectedBlob, SecretBytes, SecretProtector};
+use std::{ptr::{null, null_mut}, slice};
+use windows_sys::Win32::{
+    Foundation::LocalFree,
+    Security::Cryptography::{
+        CryptProtectData, CryptUnprotectData, CRYPT_INTEGER_BLOB, CRYPTPROTECT_UI_FORBIDDEN,
+    },
+};
+
+pub struct DpapiProtector;
+
+struct LocalBlob(CRYPT_INTEGER_BLOB);
+
+impl LocalBlob {
+    fn copy_bytes(&self, error: ProtectError) -> Result<Vec<u8>, ProtectError> {
+        if self.0.pbData.is_null() || self.0.cbData == 0 {
+            return Err(error);
+        }
+        Ok(unsafe { slice::from_raw_parts(self.0.pbData, self.0.cbData as usize).to_vec() })
+    }
+
+    fn zeroize_contents(&mut self) {
+        if !self.0.pbData.is_null() && self.0.cbData > 0 {
+            unsafe {
+                std::ptr::write_bytes(self.0.pbData, 0, self.0.cbData as usize);
+            }
+        }
+    }
+}
+
+impl Drop for LocalBlob {
+    fn drop(&mut self) {
+        if !self.0.pbData.is_null() {
+            unsafe {
+                let _ = LocalFree(self.0.pbData.cast());
+            }
+            self.0.pbData = null_mut();
+            self.0.cbData = 0;
+        }
+    }
+}
+
+impl SecretProtector for DpapiProtector {
+    fn protect(&self, secret: &SecretBytes) -> Result<ProtectedBlob, ProtectError> {
+        secret.expose_bytes(|bytes| {
+            let input = CRYPT_INTEGER_BLOB {
+                cbData: u32::try_from(bytes.len()).map_err(|_| ProtectError::ProtectFailed)?,
+                pbData: bytes.as_ptr().cast_mut(),
+            };
+            let mut output = CRYPT_INTEGER_BLOB::default();
+            let ok = unsafe {
+                CryptProtectData(
+                    &input,
+                    null(),
+                    null(),
+                    null(),
+                    null(),
+                    CRYPTPROTECT_UI_FORBIDDEN,
+                    &mut output,
+                )
+            };
+            if ok == 0 {
+                return Err(ProtectError::ProtectFailed);
+            }
+            let output = LocalBlob(output);
+            Ok(ProtectedBlob::new(output.copy_bytes(ProtectError::ProtectFailed)?))
+        })
+    }
+
+    fn unprotect(&self, protected: &ProtectedBlob) -> Result<SecretBytes, ProtectError> {
+        if !protected.verify_checksum() {
+            return Err(ProtectError::IntegrityFailed);
+        }
+
+        let input_bytes = protected.as_bytes();
+        let input = CRYPT_INTEGER_BLOB {
+            cbData: u32::try_from(input_bytes.len()).map_err(|_| ProtectError::UnprotectFailed)?,
+            pbData: input_bytes.as_ptr().cast_mut(),
+        };
+        let mut output = CRYPT_INTEGER_BLOB::default();
+        let ok = unsafe {
+            CryptUnprotectData(
+                &input,
+                null_mut(),
+                null(),
+                null(),
+                null(),
+                CRYPTPROTECT_UI_FORBIDDEN,
+                &mut output,
+            )
+        };
+        if ok == 0 {
+            return Err(ProtectError::UnprotectFailed);
+        }
+
+        let mut output = LocalBlob(output);
+        let plaintext = output.copy_bytes(ProtectError::UnprotectFailed)?;
+        output.zeroize_contents();
+        SecretBytes::from_decrypted(plaintext).map_err(|_| ProtectError::UnprotectFailed)
+    }
+}
