+    fn migrate_v1(&mut self) -> Result<(), StoreError> {
+        let transaction = self.connection.transaction().map_err(StoreError::Sqlite)?;
+        transaction
+            .execute_batch(
+                r#"
+                CREATE TABLE IF NOT EXISTS vault_keys (
+                  key_id TEXT PRIMARY KEY NOT NULL,
+                  slot_index INTEGER NOT NULL UNIQUE,
+                  label TEXT NOT NULL,
+                  masked_suffix TEXT NOT NULL,
+                  protected_blob BLOB NOT NULL,
+                  protected_blob_sha256 BLOB NOT NULL CHECK(length(protected_blob_sha256) = 32),
+                  lifecycle_state TEXT NOT NULL,
+                  availability_state TEXT NOT NULL,
+                  cooldown_until_utc_ms INTEGER,
+                  consecutive_failures INTEGER NOT NULL DEFAULT 0,
+                  last_success_at_utc_ms INTEGER,
+                  last_failure_at_utc_ms INTEGER,
+                  last_failure_class TEXT,
+                  last_probe_at_utc_ms INTEGER,
+                  limit_value REAL,
+                  limit_remaining REAL,
+                  limit_reset TEXT,
+                  usage_daily REAL,
+                  is_free_tier INTEGER,
+                  expires_at_utc_ms INTEGER,
+                  created_at_utc_ms INTEGER NOT NULL,
+                  updated_at_utc_ms INTEGER NOT NULL
+                ) STRICT;
+
+                CREATE TABLE IF NOT EXISTS rotation_state (
+                  singleton_id INTEGER PRIMARY KEY CHECK(singleton_id = 1),
+                  cursor_slot INTEGER NOT NULL,
+                  updated_at_utc_ms INTEGER NOT NULL
+                ) STRICT;
+
+                INSERT OR IGNORE INTO rotation_state(singleton_id, cursor_slot, updated_at_utc_ms)
+                VALUES(1, -1, 0);
+
+                CREATE TABLE IF NOT EXISTS vault_slot_state (
+                  singleton_id INTEGER PRIMARY KEY CHECK(singleton_id = 1),
+                  next_slot_index INTEGER NOT NULL CHECK(next_slot_index >= 0)
+                ) STRICT;
+
+                INSERT OR IGNORE INTO vault_slot_state(singleton_id, next_slot_index)
+                VALUES(1, 0);
+
+                PRAGMA user_version = 1;
+                "#,
+            )
+            .map_err(StoreError::Sqlite)?;
+        transaction.commit().map_err(StoreError::Sqlite)
+    }
+
+    fn migrate_v2(&mut self) -> Result<(), StoreError> {
+        let transaction = self.connection.transaction().map_err(StoreError::Sqlite)?;
+        transaction
+            .execute_batch(
+                r#"
+                CREATE TABLE IF NOT EXISTS vault_credential_profiles (
+                  key_id TEXT PRIMARY KEY NOT NULL,
+                  provider TEXT NOT NULL CHECK(length(provider) BETWEEN 1 AND 64),
+                  health_score REAL NOT NULL CHECK(health_score BETWEEN 0.0 AND 100.0),
+                  reliability_score REAL NOT NULL CHECK(reliability_score BETWEEN 0.0 AND 100.0),
+                  latency_score REAL NOT NULL CHECK(latency_score BETWEEN 0.0 AND 100.0),
+                  quota_score REAL NOT NULL CHECK(quota_score BETWEEN 0.0 AND 100.0),
+                  confidence_score REAL NOT NULL CHECK(confidence_score BETWEEN 0.0 AND 100.0),
+                  last_observed_at_utc_ms INTEGER,
+                  updated_at_utc_ms INTEGER NOT NULL,
+                  FOREIGN KEY(key_id) REFERENCES vault_keys(key_id) ON DELETE CASCADE
+                ) STRICT;
+
+                PRAGMA user_version = 2;
+                "#,
+            )
+            .map_err(StoreError::Sqlite)?;
+        transaction.commit().map_err(StoreError::Sqlite)
+    }
+
+    fn migrate_v3(&mut self) -> Result<(), StoreError> {
+        let transaction = self.connection.transaction().map_err(StoreError::Sqlite)?;
+        transaction
+            .execute_batch(
+                r#"
+                CREATE TABLE IF NOT EXISTS vault_credential_events (
+                  event_id INTEGER PRIMARY KEY AUTOINCREMENT,
+                  event_type TEXT NOT NULL,
+                  key_id TEXT NOT NULL,
+                  occurred_at_utc_ms INTEGER NOT NULL
+                ) STRICT;
+
+                CREATE INDEX IF NOT EXISTS idx_vault_credential_events_key_id_event_id
+                  ON vault_credential_events(key_id, event_id DESC);
+
+                PRAGMA user_version = 3;
+                "#,
+            )
+            .map_err(StoreError::Sqlite)?;
+        transaction.commit().map_err(StoreError::Sqlite)
+    }
+
+    fn migrate_v4(&mut self) -> Result<(), StoreError> {
+        let transaction = self.connection.transaction().map_err(StoreError::Sqlite)?;
+        transaction
+            .execute_batch(
+                r#"
+                CREATE TABLE IF NOT EXISTS vault_usage_observations (
+                  observation_id INTEGER PRIMARY KEY AUTOINCREMENT,
+                  key_id TEXT NOT NULL,
+                  observed_at_utc_ms INTEGER NOT NULL,
+                  limit_value REAL,
+                  limit_remaining REAL,
+                  usage_daily REAL,
+                  availability_state TEXT NOT NULL,
+                  FOREIGN KEY(key_id) REFERENCES vault_keys(key_id) ON DELETE CASCADE,
+                  UNIQUE(key_id, observed_at_utc_ms)
+                ) STRICT;
+
+                CREATE INDEX IF NOT EXISTS idx_vault_usage_observations_key_time
+                  ON vault_usage_observations(key_id, observed_at_utc_ms DESC, observation_id DESC);
+
+                PRAGMA user_version = 4;
+                "#,
+            )
+            .map_err(StoreError::Sqlite)?;
+        transaction.commit().map_err(StoreError::Sqlite)
+    }
+
+    fn ensure_slot_state(&mut self) -> Result<(), StoreError> {
+        let transaction = self.connection.transaction().map_err(StoreError::Sqlite)?;
+        transaction
+            .execute_batch(
+                r#"
+                CREATE TABLE IF NOT EXISTS vault_slot_state (
+                  singleton_id INTEGER PRIMARY KEY CHECK(singleton_id = 1),
+                  next_slot_index INTEGER NOT NULL CHECK(next_slot_index >= 0)
+                ) STRICT;
+                "#,
+            )
+            .map_err(StoreError::Sqlite)?;
+        let observed_next: i64 = transaction
+            .query_row(
+                "SELECT COALESCE(MAX(slot_index), -1) + 1 FROM vault_keys",
+                [],
+                |row| row.get(0),
+            )
+            .map_err(StoreError::Sqlite)?;
+        transaction
+            .execute(
+                "INSERT OR IGNORE INTO vault_slot_state(singleton_id, next_slot_index) VALUES(1, ?1)",
+                params![observed_next],
+            )
+            .map_err(StoreError::Sqlite)?;
+        transaction
+            .execute(
+                "UPDATE vault_slot_state SET next_slot_index = MAX(next_slot_index, ?1) WHERE singleton_id = 1",
+                params![observed_next],
+            )
+            .map_err(StoreError::Sqlite)?;
+        transaction.commit().map_err(StoreError::Sqlite)
+    }
+
+    fn verify_integrity(&self, existed: bool) -> Result<(), StoreError> {
+        let result = self
+            .connection
+            .query_row("PRAGMA integrity_check(1)", [], |row| row.get::<_, String>(0));
+        match result {
+            Ok(value) if value == "ok" => Ok(()),
+            Ok(_) => Err(StoreError::CorruptExisting),
+            Err(_error) if existed => Err(StoreError::CorruptExisting),
+            Err(error) => Err(StoreError::Sqlite(error)),
+        }
+    }
