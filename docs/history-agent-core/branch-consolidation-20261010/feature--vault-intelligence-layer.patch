+            last_probe_at_utc_ms: self.last_probe_at_utc_ms,
+            limit_value: self.limit_value,
+            limit_remaining: self.limit_remaining,
+            limit_reset: self.limit_reset,
+            usage_daily: self.usage_daily,
+            is_free_tier: self.is_free_tier,
