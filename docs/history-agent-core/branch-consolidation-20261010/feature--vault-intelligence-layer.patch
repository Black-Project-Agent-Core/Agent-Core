+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct KeySummary {
+    pub key_id: KeyId,
+    pub slot_index: i64,
+    pub label: String,
+    pub masked_suffix: String,
+    pub lifecycle_state: LifecycleState,
