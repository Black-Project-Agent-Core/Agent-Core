+        health_score: row.get(2)?,
+        reliability_score: row.get(3)?,
+        latency_score: row.get(4)?,
+        quota_score: row.get(5)?,
+        confidence_score: row.get(6)?,
+        last_observed_at_utc_ms: row.get(7)?,
+        updated_at_utc_ms: row.get(8)?,
+    })
