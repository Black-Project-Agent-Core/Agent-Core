+function scoreRecord(
+  record: MemoryRecord,
+  query: string,
+  semantic?: SemanticSearchContext,
+  sourceFiles: string[] = [],
+  bm25Score = 0,
+  bm25Weight = 0,
+  rankingTime = Date.now(),
+): { score: number; components: RetrievalComponents } {
+  const normalizedQuery = query.trim().toLowerCase();
