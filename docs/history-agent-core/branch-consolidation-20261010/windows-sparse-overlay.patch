+    let handedOffExposures = 0;
+    let assessedAttempts = 0;
+    let helpful = 0;
+    let stale = 0;
+    let harmful = 0;
+    let explicitFeedbackEvents = 0;
+    let linkedFeatureOutcomes = 0;
