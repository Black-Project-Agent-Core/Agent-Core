+function nearestMarker(candidatePath: string): LoadedMarker | null {
+  let current = markerStart(candidatePath);
+  for (let depth = 0; depth < MAX_ANCESTORS; depth += 1) {
+    const marker = path.join(current, EVIDENCE_POLICY_MARKER);
