+const INPUT_BYTES = 32 * 1024 * 1024;
+const INPUT_PIXELS = 24_000_000;
+const OUTPUT_BYTES = 2 * 1024 * 1024;
+const OUTPUT_EDGE = 1536;
+const OUTPUT_PIXELS = 1_500_000;
+const VIEW_TTL = 15 * 60_000;
+const MAX_VIEWS = 64;
