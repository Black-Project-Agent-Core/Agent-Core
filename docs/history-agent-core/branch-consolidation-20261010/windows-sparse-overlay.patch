+    return { disposition: 'full', policyState: 'inactive', pathCount: 0, ruleCount: 0, markerCount: 0 };
+  }
+  if (extracted.paths.length === 0) {
+    return {
+      disposition: 'metadata-only',
+      policyState: 'invalid',
+      pathCount: 0,
+      ruleCount: 0,
+      markerCount: 0,
+      reason: 'known-file-tool-without-trustworthy-path',
+    };
+  }
