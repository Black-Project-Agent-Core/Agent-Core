+  } catch {
+    return {
+      disposition: 'metadata-only',
+      policyState: 'invalid',
+      pathCount: paths.length,
+      ruleCount,
+      markerCount: markers.size,
+      reason: 'policy-match-failed',
+    };
+  }
+
+  return {
+    disposition,
+    policyState: 'active',
+    pathCount: paths.length,
+    ruleCount,
+    markerCount: markers.size,
+  };
+}
