+    const afterNodeCreateCalls = snapshotCalls;
+    source.emit('activity', { sequence: 11, timestamp: new Date().toISOString(), category: 'memory', event: 'memory.node_created', state: 'completed', memoryIds: ['a3'] }, '11');
