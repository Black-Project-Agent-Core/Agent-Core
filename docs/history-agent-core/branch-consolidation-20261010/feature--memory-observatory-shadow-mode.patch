+.observatory-shell { min-height: 100vh; background: var(--canvas); color: var(--text); }
+.observatory-header { height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 0 16px; border-bottom: 1px solid var(--border); background: var(--surface); }
+.observatory-header h1 { margin: 0; font-size: 14px; font-weight: 650; letter-spacing: -.01em; }
+.status { color: var(--muted); font-size: 10px; font-weight: 650; letter-spacing: .08em; }
+.status.healthy { color: var(--online); }
+.observatory-workspace { height: calc(100vh - 48px); display: grid; grid-template-columns: minmax(0, 68fr) minmax(360px, 32fr); }
+.graph-column { min-width: 0; min-height: 0; display: grid; grid-template-rows: 38px minmax(0, 1fr); border-right: 1px solid var(--border); }
+.graph-panel { min-width: 0; min-height: 0; display: grid; grid-template-rows: 42px 42px minmax(0, 1fr); background: var(--surface); }
+.panel-heading { min-height: 42px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 14px; border-bottom: 1px solid var(--border); }
+.panel-heading > div:first-child { display: flex; align-items: baseline; gap: 10px; }
+.panel-heading strong { font-size: 12px; font-weight: 650; }
+.panel-heading span { color: var(--muted); font-size: 10px; }
+.graph-actions { display: flex; gap: 6px; }
+.graph-actions button { border: 1px solid var(--border); border-radius: 6px; background: #fff; color: var(--text); padding: 5px 9px; font-size: 10px; cursor: pointer; }
+.graph-actions button:disabled { opacity: .45; cursor: default; }
+.graph-filters { display: grid; grid-template-columns: minmax(150px, 1fr) 130px 130px; gap: 7px; align-items: center; padding: 6px 12px; border-bottom: 1px solid var(--border); background: #fbfcfd; }
+.graph-filters input, .graph-filters select { min-width: 0; height: 29px; border: 1px solid var(--border); border-radius: 6px; background: #fff; color: var(--text); padding: 0 8px; font-size: 10px; outline: none; }
