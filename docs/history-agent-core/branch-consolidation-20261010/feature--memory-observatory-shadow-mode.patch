+**Architecture:** The live cursor is the existing AuditJournal `sequence`, assigned only after a record is successfully appended. Live events therefore correspond to durable flight-recorder records. There is no second sequence authority.
+
+**Interfaces:**
+
+```ts
+export interface AuditReplayRequest {
+  afterSequence: number;
+  limit: number;
+  categories?: string[];
+}
+
+export type AuditReplayResult =
+  | { ok: true; records: AuditJournalRecord[]; earliestSequence: number; latestSequence: number }
+  | { ok: false; code: 'AUDIT_HISTORY_GAP'; earliestSequence: number; latestSequence: number };
+
+export interface AuditRecordSubscription {
+  close(): void;
+}
+
+export interface AuditRecordBroadcaster {
+  publish(record: AuditJournalRecord): void;
+  subscribe(listener: (record: AuditJournalRecord) => void): AuditRecordSubscription;
+}
+```
+
