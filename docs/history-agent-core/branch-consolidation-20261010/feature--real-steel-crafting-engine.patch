+  | 'DUPLICATE_AUTHORITY_OWNER'
+  | 'BOUND_TO_CANONICAL_AUTHORITY'
+  | 'DONOR_AUTHORITY_DROPPED'
+  | 'AUTHORITY_SPAREPART_NOT_FOUND';
+
+export interface CraftingAuthorityConflict {
+  conflictId: string;
+  sparepartId: string;
+  authorityId: ProtectedAuthorityId;
+  status: 'resolved' | 'blocking';
+  reasonCode: CraftingAuthorityConflictReason;
+  targetBinding?: string;
+}
diff --git a/src/crafting/compatibility-surgery.ts b/src/crafting/compatibility-surgery.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c572924cc2395fdff53e2b940db3deb97bbea1c7
--- /dev/null
+++ b/src/crafting/compatibility-surgery.ts
@@ -0,0 +1,178 @@
+import { createHash } from 'node:crypto';
+import type { CraftPlan, CraftingDecision } from './craft-plan.js';
+import {
+  PROTECTED_CRAFTING_AUTHORITIES,
+  type CraftingAuthorityConflict,
+  type DonorAuthorityClaim,
+} from './authority-registry.js';
+
+export type CompatibilitySurgery =
+  | 'NONE'
+  | 'ADAPTER'
+  | 'TYPE_MAP'
+  | 'AUTHORITY_REPLACEMENT'
+  | 'LIFECYCLE_REWIRE'
+  | 'ERROR_MAP';
+
+export interface CompatibilityBinding {
+  sparepartId: string;
+  boundary: string;
+  donorContract: string;
+  hostContract: string;
+  surgery: CompatibilitySurgery;
+  verificationRequirement: string;
+  preservesHostAuthority: boolean;
+}
+
+export interface CompatibleCraftPlan extends CraftPlan {
+  compatibilityBindings: CompatibilityBinding[];
+  authorityConflicts: CraftingAuthorityConflict[];
+}
+
+export class CompatibilitySurgeryError extends Error {
+  constructor(readonly code: string, message: string) {
+    super(message);
+    this.name = 'CompatibilitySurgeryError';
+  }
+}
+function stableJson(value: unknown): string {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return `[${value.map(stableJson).join(',')}]`;
+  return `{${Object.entries(value as Record<string, unknown>)
+    .sort(([left], [right]) => left.localeCompare(right))
+    .map(([key, item]) => `${JSON.stringify(key)}:${stableJson(item)}`)
+    .join(',')}}`;
+}
+
+function bindingKey(item: CompatibilityBinding): string {
+  return [item.sparepartId, item.boundary, item.hostContract, item.donorContract, item.surgery].join('\u0000');
+}
+
+function normalizeBinding(item: CompatibilityBinding): CompatibilityBinding {
+  const result = {
+    sparepartId: item.sparepartId.trim(),
+    boundary: item.boundary.trim(),
+    donorContract: item.donorContract.trim(),
+    hostContract: item.hostContract.trim(),
+    surgery: item.surgery,
+    verificationRequirement: item.verificationRequirement.trim(),
+    preservesHostAuthority: item.preservesHostAuthority,
+  };
+  if (!result.sparepartId || !result.boundary || !result.donorContract
+    || !result.hostContract || !result.verificationRequirement) {
+    throw new CompatibilitySurgeryError('COMPATIBILITY_BINDING_INVALID', 'Compatibility bindings require sparepart, boundary, contracts, and verification');
+  }
+  if (!result.preservesHostAuthority) {
+    throw new CompatibilitySurgeryError('HOST_GUARDRAIL_WEAKENED', `Compatibility binding weakens host authority: ${result.sparepartId}/${result.boundary}`);
+  }
+  return result;
+}
+function conflictId(value: Omit<CraftingAuthorityConflict, 'conflictId'>): string {
+  return `authority:${createHash('sha256').update(stableJson(value), 'utf8').digest('hex').slice(0, 32)}`;
+}
+
+function authorityConflict(
+  claim: DonorAuthorityClaim,
+  status: 'resolved' | 'blocking',
+  reasonCode: CraftingAuthorityConflict['reasonCode'],
+  targetBinding?: string,
+): CraftingAuthorityConflict {
+  const body: Omit<CraftingAuthorityConflict, 'conflictId'> = {
+    sparepartId: claim.sparepartId,
+    authorityId: claim.authorityId,
+    status,
+    reasonCode,
+    ...(targetBinding ? { targetBinding } : {}),
+  };
+  return { conflictId: conflictId(body), ...body };
+}
+
+function evaluateClaims(
+  decisions: Map<string, CraftingDecision>,
+  bindings: CompatibilityBinding[],
+  claims: DonorAuthorityClaim[],
+): CraftingAuthorityConflict[] {
+  const conflicts: CraftingAuthorityConflict[] = [];
+  for (const claim of claims) {
+    if (claim.role !== 'owner') continue;
+    const decision = decisions.get(claim.sparepartId);
+    if (!decision) {
+      conflicts.push(authorityConflict(claim, 'blocking', 'AUTHORITY_SPAREPART_NOT_FOUND'));
+      continue;
+    }
+    if (decision.action === 'DROP') {
+      conflicts.push(authorityConflict(claim, 'resolved', 'DONOR_AUTHORITY_DROPPED'));
+      continue;
+    }
+    const canonical = PROTECTED_CRAFTING_AUTHORITIES[claim.authorityId].canonicalBinding;
+    const boundary = bindings.find((item) => item.sparepartId === claim.sparepartId
+      && item.hostContract === canonical
+      && (item.surgery === 'AUTHORITY_REPLACEMENT' || item.surgery === 'ADAPTER'));
+    const boundaryAction = decision.action === 'ADAPT'
+      || decision.action === 'REPLACE'
+      || decision.action === 'REIMPLEMENT';
+    if (boundary && boundaryAction && decision.targetBinding === canonical) {
+      conflicts.push(authorityConflict(claim, 'resolved', 'BOUND_TO_CANONICAL_AUTHORITY', canonical));
+      continue;
+    }
+    conflicts.push(authorityConflict(
+      claim,
+      'blocking',
+      'DUPLICATE_AUTHORITY_OWNER',
+      decision.targetBinding,
+    ));
+  }
+  return conflicts.sort((left, right) => left.conflictId.localeCompare(right.conflictId));
+}
+
+export function applyCompatibilitySurgery(input: {
+  craftPlan: CraftPlan;
+  bindings: CompatibilityBinding[];
+  authorityClaims: DonorAuthorityClaim[];
+}): CompatibleCraftPlan {
+  if (input.craftPlan.status !== 'ready') {
+    throw new CompatibilitySurgeryError('CRAFT_PLAN_NOT_READY', 'Compatibility surgery requires a decision-ready craft plan');
+  }
+  const decisions = new Map(input.craftPlan.decisions.map((item) => [item.sparepartId, item]));
+  const bindings = input.bindings.map(normalizeBinding)
+    .sort((left, right) => bindingKey(left).localeCompare(bindingKey(right)));
+  const seenBindings = new Set<string>();
+  for (const item of bindings) {
+    if (!decisions.has(item.sparepartId)) {
+      throw new CompatibilitySurgeryError('COMPATIBILITY_SPAREPART_UNKNOWN', `Binding targets unknown sparepart: ${item.sparepartId}`);
+    }
+    if (decisions.get(item.sparepartId)?.action === 'DROP') {
+      throw new CompatibilitySurgeryError('COMPATIBILITY_FOR_DROPPED_SPAREPART', `Dropped sparepart cannot carry a compatibility binding: ${item.sparepartId}`);
+    }
+    const key = bindingKey(item);
+    if (seenBindings.has(key)) throw new CompatibilitySurgeryError('COMPATIBILITY_BINDING_DUPLICATE', `Duplicate compatibility binding: ${key}`);
+    seenBindings.add(key);
+  }
+
+  const blockingReasons: string[] = [];
+  for (const decision of input.craftPlan.decisions) {
+    if (!decision.targetBinding) continue;
+    const mapped = bindings.some((item) => item.sparepartId === decision.sparepartId
+      && item.hostContract === decision.targetBinding);
+    if (!mapped) blockingReasons.push(`COMPATIBILITY_BINDING_REQUIRED:${decision.sparepartId}`);
+  }
+  const authorityConflicts = evaluateClaims(decisions, bindings, input.authorityClaims);
+  blockingReasons.push(...authorityConflicts
+    .filter((item) => item.status === 'blocking')
+    .map((item) => `AUTHORITY_CONFLICT:${item.sparepartId}:${item.authorityId}`));
+  blockingReasons.sort();
+  const identity = {
+    baseCraftPlanId: input.craftPlan.craftPlanId,
+    bindings,
+    authorityConflicts,
+    blockingReasons,
+  };
+  return {
+    ...structuredClone(input.craftPlan),
+    craftPlanId: `craft-plan:${createHash('sha256').update(stableJson(identity), 'utf8').digest('hex').slice(0, 32)}`,
+    compatibilityBindings: bindings,
+    authorityConflicts,
+    status: blockingReasons.length > 0 ? 'blocked' : 'ready',
+    blockingReasons,
+  };
+}
diff --git a/src/crafting/continuity.ts b/src/crafting/continuity.ts
new file mode 100644
index 0000000000000000000000000000000000000000..23ee400acdedb1b4497533e5304fcd86646187da
--- /dev/null
+++ b/src/crafting/continuity.ts
@@ -0,0 +1,186 @@
+import type { ContinuityCheckpointRecord } from '../continuity/store.js';
+import type { ContinuityCheckpointInput } from '../continuity/types.js';
+import type { MemoryPostflightCandidate } from '../memory/types.js';
+import type { RouteCraftingProjection } from '../runtime/route-context-store.js';
+import type { CraftPlan } from './craft-plan.js';
+import type { CraftingModeDecision, CraftingReference } from './types.js';
+import type { CraftingVerificationResult } from './verification.js';
+
+export interface CraftingContinuityReference {
+  referenceId: string;
+  kind: CraftingReference['kind'];
+  repository?: string;
+  commit?: string;
+  tree?: string;
+  bundleHash?: string;
+}
+
+export interface CraftingContinuityProjection {
+  craftingId: string;
+  mode: CraftingModeDecision['mode'];
+  featureContractHash: string;
+  referenceSetHash: string;
+  craftPlanId: string;
+  groundingReceiptId?: string;
+  references: CraftingContinuityReference[];
+  currentSparepartId?: string;
+  executionRunId?: string;
+  verificationStatus: 'pending' | 'verified' | 'blocked';
+  blockingReason?: string;
+}
+
+const LEGACY_DECISION_KEY = 'real_steel_crafting_state';
+export const CRAFTING_CONTINUITY_EVIDENCE_REF = 'agent-core:real-steel-crafting-state:v1';
+const VERSION = 1;
+
+function bounded(value: string | undefined, max = 5_000): string | undefined {
+  const normalized = value?.normalize('NFKC').trim();
+  if (!normalized) return undefined;
+  if (normalized.length > max) throw new Error('CRAFTING_CONTINUITY_VALUE_TOO_LONG');
+  return normalized;
+}
+
+function normalizeReferences(values: CraftingContinuityReference[]): CraftingContinuityReference[] {
+  return values.map((reference) => ({
+    referenceId: bounded(reference.referenceId, 200)!,
+    kind: reference.kind,
+    ...(bounded(reference.repository, 500) ? { repository: bounded(reference.repository, 500) } : {}),
+    ...(bounded(reference.commit, 128) ? { commit: bounded(reference.commit, 128) } : {}),
+    ...(bounded(reference.tree, 128) ? { tree: bounded(reference.tree, 128) } : {}),
+    ...(bounded(reference.bundleHash, 128) ? { bundleHash: bounded(reference.bundleHash, 128) } : {}),
+  })).sort((left, right) => left.referenceId.localeCompare(right.referenceId));
+}
+
+function normalizedProjection(input: CraftingContinuityProjection): CraftingContinuityProjection {
+  const craftingId = bounded(input.craftingId, 500);
+  const featureContractHash = bounded(input.featureContractHash, 128);
+  const referenceSetHash = bounded(input.referenceSetHash, 128);
+  const craftPlanId = bounded(input.craftPlanId, 500);
+  if (!craftingId || !featureContractHash || !referenceSetHash || !craftPlanId) {
+    throw new Error('CRAFTING_CONTINUITY_IDENTITY_REQUIRED');
+  }
+  return {
+    craftingId,
+    mode: input.mode,
+    featureContractHash,
+    referenceSetHash,
+    craftPlanId,
+    ...(bounded(input.groundingReceiptId, 500) ? { groundingReceiptId: bounded(input.groundingReceiptId, 500) } : {}),
+    references: normalizeReferences(input.references),
+    ...(bounded(input.currentSparepartId, 500) ? { currentSparepartId: bounded(input.currentSparepartId, 500) } : {}),
+    ...(bounded(input.executionRunId, 500) ? { executionRunId: bounded(input.executionRunId, 500) } : {}),
+    verificationStatus: input.verificationStatus,
+    ...(bounded(input.blockingReason, 2_000) ? { blockingReason: bounded(input.blockingReason, 2_000) } : {}),
+  };
+}
+
+export function buildCraftingCheckpointInput(
+  routeContextId: string,
+  projection: CraftingContinuityProjection,
+  options: { status?: ContinuityCheckpointInput['status'] } = {},
+): ContinuityCheckpointInput {
+  const state = normalizedProjection(projection);
+  const payload = JSON.stringify({ version: VERSION, ...state });
+  return {
+    routeContextId,
+    status: options.status ?? (state.verificationStatus === 'verified' ? 'completed' : 'running'),
+    summary: `Real Steel crafting checkpoint ${state.craftingId}`,
+    evidence: [
+      { type: 'tool', ref: CRAFTING_CONTINUITY_EVIDENCE_REF, result: payload },
+      { type: 'hash', ref: `craft-plan:${state.craftPlanId}`, result: state.craftPlanId },
+      { type: 'hash', ref: `reference-set:${state.referenceSetHash}`, result: state.referenceSetHash },
+    ],
+    ...(state.blockingReason ? { blockers: [{ code: 'CRAFTING_BLOCKED', detail: state.blockingReason }] } : {}),
+    ...(state.verificationStatus === 'verified'
+      ? { outcomes: [{ key: 'crafting_verified', value: state.craftPlanId, evidenceRefs: [`craft-plan:${state.craftPlanId}`] }] }
+      : {}),
+  };
+}
+
+export function parseCraftingContinuityCheckpoint(
+  checkpoint: ContinuityCheckpointRecord,
+): CraftingContinuityProjection {
+  const evidenceRecord = checkpoint.evidence.find((item) => item.ref === CRAFTING_CONTINUITY_EVIDENCE_REF);
+  const legacyRecord = checkpoint.decisions.find((item) => item.key === LEGACY_DECISION_KEY);
+  const payload = evidenceRecord?.result ?? legacyRecord?.value;
+  if (!payload) throw new Error('CRAFTING_CONTINUITY_STATE_MISSING');
+  let parsed: unknown;
+  try { parsed = JSON.parse(payload); }
+  catch { throw new Error('CRAFTING_CONTINUITY_STATE_INVALID'); }
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
+    throw new Error('CRAFTING_CONTINUITY_STATE_INVALID');
+  }
+  const value = parsed as Record<string, unknown>;
+  if (value.version !== VERSION || !Array.isArray(value.references)) {
+    throw new Error('CRAFTING_CONTINUITY_VERSION_INVALID');
+  }
+  return normalizedProjection({
+    craftingId: String(value.craftingId ?? ''),
+    mode: value.mode as CraftingModeDecision['mode'],
+    featureContractHash: String(value.featureContractHash ?? ''),
+    referenceSetHash: String(value.referenceSetHash ?? ''),
+    craftPlanId: String(value.craftPlanId ?? ''),
+    ...(value.groundingReceiptId ? { groundingReceiptId: String(value.groundingReceiptId) } : {}),
+    references: value.references as CraftingContinuityReference[],
+    ...(value.currentSparepartId ? { currentSparepartId: String(value.currentSparepartId) } : {}),
+    ...(value.executionRunId ? { executionRunId: String(value.executionRunId) } : {}),
+    verificationStatus: value.verificationStatus as CraftingContinuityProjection['verificationStatus'],
+    ...(value.blockingReason ? { blockingReason: String(value.blockingReason) } : {}),
+  });
+}
+
+function stale(message: string): never {
+  throw new Error(`CRAFTING_CONTINUITY_STALE: ${message}`);
+}
+
+export function resumeCraftingProjection(
+  savedInput: CraftingContinuityProjection,
+  currentDecision: CraftingModeDecision,
+  currentPlan: CraftPlan,
+): RouteCraftingProjection {
+  const saved = normalizedProjection(savedInput);
+  if (saved.craftingId !== currentDecision.craftingId
+    || saved.mode !== currentDecision.mode
+    || saved.featureContractHash !== currentDecision.featureContractHash
+    || saved.referenceSetHash !== currentDecision.referenceSetHash) {
+    stale('mode/plan/reference identity changed');
+  }
+  if (currentPlan.status !== 'ready'
+    || currentPlan.craftingId !== currentDecision.craftingId
+    || currentPlan.mode !== currentDecision.mode
+    || currentPlan.featureContractHash !== currentDecision.featureContractHash
+    || currentPlan.referenceSetHash !== currentDecision.referenceSetHash
+    || currentPlan.craftPlanId !== saved.craftPlanId
+    || (currentPlan.groundingReceiptId ?? '') !== (saved.groundingReceiptId ?? '')) {
+    stale('craft plan or grounding identity changed');
+  }
+  const state: RouteCraftingProjection['state'] = saved.verificationStatus === 'verified'
+    ? 'closed'
+    : saved.verificationStatus === 'blocked'
+      ? 'verification_pending'
+      : 'ready';
+  return {
+    craftingId: currentDecision.craftingId,
+    mode: currentDecision.mode,
+    featureContractHash: currentDecision.featureContractHash,
+    referenceSetHash: currentDecision.referenceSetHash,
+    ...(saved.groundingReceiptId ? { groundingReceiptId: saved.groundingReceiptId } : {}),
+    craftPlanId: currentPlan.craftPlanId,
+    state,
+  };
+}
+
+export function toMemoryPostflightCandidate(
+  result: CraftingVerificationResult,
+): MemoryPostflightCandidate | null {
+  const candidate = result.status === 'verified' ? result.memoryCandidate : null;
+  if (!candidate) return null;
+  return {
+    canonicalKey: candidate.canonicalKey,
+    kind: candidate.kind,
+    value: structuredClone(candidate.value),
+    importance: candidate.importance,
+    sourceType: candidate.sourceType,
+    sourceRef: candidate.sourceRef,
+  };
+}
diff --git a/src/crafting/craft-plan.ts b/src/crafting/craft-plan.ts
new file mode 100644
index 0000000000000000000000000000000000000000..093b4918b58e11d3024fd2859fec5a9c3f066d28
--- /dev/null
+++ b/src/crafting/craft-plan.ts
@@ -0,0 +1,176 @@
+import { createHash } from 'node:crypto';
+import type { FeatureAnatomy, FeatureSparepart } from './feature-anatomy.js';
+import type { SourceGroundingReceipt } from './source-grounding.js';
+import type { CraftingMode, CraftingModeDecision } from './types.js';
+
+export type CraftingAction = 'KEEP' | 'ADAPT' | 'REPLACE' | 'DROP' | 'REIMPLEMENT';
+export type ReimplementationReason =
+  | 'LICENSE_BLOCKED'
+  | 'RUNTIME_NON_PORTABLE'
+  | 'DONOR_BROKEN'
+  | 'IRREDUCIBLE_HOST_CONFLICT';
+
+export interface CraftingDecision {
+  sparepartId: string;
+  action: CraftingAction;
+  rationaleCode: string;
+  targetPath?: string;
+  targetBinding?: string;
+  preservedBehaviors: string[];
+  intentionallyChangedBehaviors: string[];
+  evidenceRefs: string[];
+  reimplementationReason?: ReimplementationReason;
+}
+
+export interface CraftPlan {
+  craftPlanId: string;
+  craftingId: string;
+  mode: CraftingMode;
+  featureContractHash: string;
+  referenceSetHash: string;
+  groundingReceiptId?: string;
+  anatomyId?: string;
+  decisions: CraftingDecision[];
+  hostVerification: string[];
+  donorVerification: string[];
+  status: 'draft' | 'ready' | 'blocked';
+  blockingReasons: string[];
+}
+export class CraftPlanError extends Error {
+  constructor(readonly code: string, message: string) {
+    super(message);
+    this.name = 'CraftPlanError';
+  }
+}
+
+function stableJson(value: unknown): string {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return `[${value.map(stableJson).join(',')}]`;
+  return `{${Object.entries(value as Record<string, unknown>)
+    .sort(([left], [right]) => left.localeCompare(right))
+    .map(([key, item]) => `${JSON.stringify(key)}:${stableJson(item)}`)
+    .join(',')}}`;
+}
+
+function normalizedStrings(values: string[]): string[] {
+  return [...new Set(values.map((value) => value.trim()).filter(Boolean))].sort();
+}
+
+function normalizeDecision(item: CraftingDecision, sparepart: FeatureSparepart): CraftingDecision {
+  const sparepartId = item.sparepartId.trim();
+  const rationaleCode = item.rationaleCode.trim();
+  const evidenceRefs = normalizedStrings(item.evidenceRefs);
+  if (!sparepartId || !rationaleCode || evidenceRefs.length === 0) {
+    throw new CraftPlanError('CRAFT_DECISION_INVALID', `Crafting decision requires sparepart, rationale, and evidence: ${sparepartId || '<missing>'}`);
+  }
+  for (const evidenceId of evidenceRefs) {
+    if (!sparepart.evidenceRefs.includes(evidenceId)) {
+      throw new CraftPlanError('CRAFT_DECISION_EVIDENCE_INVALID', `Decision ${sparepartId} cites evidence outside its sparepart anatomy`);
+    }
+  }
+  if (item.action === 'REIMPLEMENT' && !item.reimplementationReason) {
+    throw new CraftPlanError('REIMPLEMENT_REASON_REQUIRED', `REIMPLEMENT requires factual exception reason: ${sparepartId}`);
+  }
+  return {
+    sparepartId,
+    action: item.action,
+    rationaleCode,
+    ...(item.targetPath?.trim() ? { targetPath: item.targetPath.trim() } : {}),
+    ...(item.targetBinding?.trim() ? { targetBinding: item.targetBinding.trim() } : {}),
+    preservedBehaviors: normalizedStrings(item.preservedBehaviors),
+    intentionallyChangedBehaviors: normalizedStrings(item.intentionallyChangedBehaviors),
+    evidenceRefs,
+    ...(item.reimplementationReason ? { reimplementationReason: item.reimplementationReason } : {}),
+  };
+}
+
+export function buildCraftPlan(input: {
+  decision: CraftingModeDecision;
+  groundingReceipt?: SourceGroundingReceipt;
+  anatomy?: FeatureAnatomy;
+  decisions: CraftingDecision[];
+  hostVerification: string[];
+  donorVerification: string[];
+}): CraftPlan {
+  if (input.decision.mode === 'BUILD_FROM_ZERO') {
+    if (input.groundingReceipt || input.anatomy || input.decisions.length > 0) {
+      throw new CraftPlanError('DONOR_STATE_FORBIDDEN', 'BUILD_FROM_ZERO craft plan cannot contain donor grounding/anatomy decisions');
+    }
+    const hostVerification = normalizedStrings(input.hostVerification);
+    const identity = {
+      craftingId: input.decision.craftingId,
+      mode: input.decision.mode,
+      featureContractHash: input.decision.featureContractHash,
+      referenceSetHash: input.decision.referenceSetHash,
+      hostVerification,
+    };
+    const craftPlanId = `craft-plan:${createHash('sha256').update(stableJson(identity), 'utf8').digest('hex').slice(0, 32)}`;
+    return {
+      craftPlanId,
+      craftingId: input.decision.craftingId,
+      mode: input.decision.mode,
+      featureContractHash: input.decision.featureContractHash,
+      referenceSetHash: input.decision.referenceSetHash,
+      decisions: [],
+      hostVerification,
+      donorVerification: [],
+      status: 'ready',
+      blockingReasons: [],
+    };
+  }
+
+  const groundingReceipt = input.groundingReceipt;
+  const anatomy = input.anatomy;
+  if (!groundingReceipt || groundingReceipt.completeness !== 'sufficient'
+    || groundingReceipt.referenceSetHash !== input.decision.referenceSetHash
+    || groundingReceipt.featureContractHash !== input.decision.featureContractHash) {
+    throw new CraftPlanError('GROUNDING_REQUIRED', 'FEATURE_TRANSPLANTATION requires current sufficient grounding');
+  }
+  if (!anatomy || anatomy.status !== 'ready' || anatomy.groundingReceiptId !== groundingReceipt.receiptId) {
+    throw new CraftPlanError('ANATOMY_REQUIRED', 'FEATURE_TRANSPLANTATION requires ready feature anatomy');
+  }
+
+  const spareparts = new Map(anatomy.spareparts.map((item) => [item.sparepartId, item]));
+  const normalized: CraftingDecision[] = [];
+  const decided = new Set<string>();
+  for (const item of input.decisions) {
+    const sparepart = spareparts.get(item.sparepartId.trim());
+    if (!sparepart) throw new CraftPlanError('CRAFT_DECISION_UNKNOWN_SPAREPART', `Decision targets unknown sparepart: ${item.sparepartId}`);
+    if (decided.has(sparepart.sparepartId)) throw new CraftPlanError('CRAFT_DECISION_DUPLICATE', `Sparepart has multiple decisions: ${sparepart.sparepartId}`);
+    decided.add(sparepart.sparepartId);
+    normalized.push(normalizeDecision(item, sparepart));
+  }
+  const missing = anatomy.spareparts.map((item) => item.sparepartId).filter((id) => !decided.has(id));
+  if (missing.length > 0) {
+    throw new CraftPlanError('CRAFT_DECISION_MISSING', `Spareparts are missing crafting decisions: ${missing.join(', ')}`);
+  }
+  normalized.sort((left, right) => left.sparepartId.localeCompare(right.sparepartId));
+  const hostVerification = normalizedStrings(input.hostVerification);
+  const donorVerification = normalizedStrings(input.donorVerification);
+  const identity = {
+    craftingId: input.decision.craftingId,
+    mode: input.decision.mode,
+    featureContractHash: input.decision.featureContractHash,
+    referenceSetHash: input.decision.referenceSetHash,
+    groundingReceiptId: groundingReceipt.receiptId,
+    anatomyId: anatomy.anatomyId,
+    decisions: normalized,
+    hostVerification,
+    donorVerification,
+  };
+  const craftPlanId = `craft-plan:${createHash('sha256').update(stableJson(identity), 'utf8').digest('hex').slice(0, 32)}`;
+  return {
+    craftPlanId,
+    craftingId: input.decision.craftingId,
+    mode: input.decision.mode,
+    featureContractHash: input.decision.featureContractHash,
+    referenceSetHash: input.decision.referenceSetHash,
+    groundingReceiptId: groundingReceipt.receiptId,
+    anatomyId: anatomy.anatomyId,
+    decisions: normalized,
+    hostVerification,
+    donorVerification,
+    status: 'ready',
+    blockingReasons: [],
+  };
+}
diff --git a/src/crafting/evidence-ledger.ts b/src/crafting/evidence-ledger.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6603900a42413adbab3f950e95f521a1068e1837
--- /dev/null
+++ b/src/crafting/evidence-ledger.ts
@@ -0,0 +1,37 @@
+import type { SourceEvidence, SourceGroundingReceipt } from './source-grounding.js';
+
+export class EvidenceLedgerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'EvidenceLedgerError';
+  }
+}
+
+export class EvidenceLedger {
+  private readonly evidence = new Map<string, SourceEvidence>();
+
+  constructor(readonly receipt: SourceGroundingReceipt) {
+    for (const item of receipt.evidence) {
+      if (this.evidence.has(item.evidenceId)) {
+        throw new EvidenceLedgerError(`Duplicate source evidence: ${item.evidenceId}`);
+      }
+      this.evidence.set(item.evidenceId, structuredClone(item));
+    }
+  }
+
+  has(evidenceId: string): boolean {
+    return this.evidence.has(evidenceId);
+  }
+
+  require(evidenceRefs: string[], label: string): SourceEvidence[] {
+    if (evidenceRefs.length === 0) throw new EvidenceLedgerError(`${label} requires evidence`);
+    return evidenceRefs.map((evidenceId) => {
+      const item = this.evidence.get(evidenceId);
+      if (!item) throw new EvidenceLedgerError(`${label} cites unknown evidence: ${evidenceId}`);
+      return structuredClone(item);
+    });
+  }
+  ids(): string[] {
+    return [...this.evidence.keys()].sort();
+  }
+}
diff --git a/src/crafting/execution-controller.ts b/src/crafting/execution-controller.ts
new file mode 100644
index 0000000000000000000000000000000000000000..24952e1ddb2e7bce22b860c7f307449a09ebc7fa
--- /dev/null
+++ b/src/crafting/execution-controller.ts
@@ -0,0 +1,213 @@
+import type { CraftPlan } from './craft-plan.js';
+import type { CreateExecutionGraphInput, ExecutionRunView } from '../execution/service.js';
+import type { ExecutionAttemptRecord } from '../execution/store.js';
+import type { ExecutionScope } from '../execution/types.js';
+import type { ExecutionExpectedArtifactSpec } from '../execution/dag.js';
+
+export interface CraftingExecutionBackend {
+  create(scope: ExecutionScope, input: CreateExecutionGraphInput): Promise<ExecutionRunView>;
+  start(scope: ExecutionScope, runId: string): Promise<ExecutionRunView>;
+  status(scope: ExecutionScope, runId: string): Promise<ExecutionRunView | null>;
+  retry(scope: ExecutionScope, runId: string, nodeId: string): Promise<ExecutionRunView>;
+  attempts(scope: ExecutionScope, runId: string, nodeId?: string): Promise<ExecutionAttemptRecord[]>;
+}
+
+export interface CraftingExecutionStep {
+  stepId: string;
+  purpose: string;
+  command: string;
+  cwd: string;
+  sparepartId?: string;
+  compatibilityBoundary?: string;
+  dependsOn?: string[];
+  timeoutMs?: number;
+  continueOnFailure?: boolean;
+  expectedArtifacts?: ExecutionExpectedArtifactSpec[];
+}
+
+export interface CraftingExecutionDagRequest {
+  objective: string;
+  steps: CraftingExecutionStep[];
+  maxConcurrency?: number;
+  continuityTaskId?: string;
+  originRouteContextId?: string;
+}
+export type CraftingExecutionNextAction =
+  | { kind: 'REPAIR_RETRY'; nodeIds: string[] }
+  | { kind: 'WAIT'; nodeIds: string[] }
+  | { kind: 'VERIFY'; nodeIds: string[] }
+  | { kind: 'BLOCKED'; nodeIds: string[] }
+  | { kind: 'NONE'; nodeIds: [] };
+export interface CraftingExecutionEvaluation {
+  status: 'active' | 'repair_required' | 'verification_pending' | 'blocked' | 'verified';
+  failedNodeIds: string[];
+  blockedNodeIds: string[];
+  activeNodeIds: string[];
+  missingEvidenceNodeIds: string[];
+  nextAction: CraftingExecutionNextAction;
+}
+
+export interface CraftingExecutionObservation extends CraftingExecutionEvaluation {
+  run: ExecutionRunView;
+  attempts: ExecutionAttemptRecord[];
+}
+
+function sortedUnique(values: string[]): string[] {
+  return [...new Set(values)].sort((left, right) => left.localeCompare(right));
+}
+
+export function evaluateCraftingExecution(
+  run: ExecutionRunView,
+  _attempts: ExecutionAttemptRecord[],
+): CraftingExecutionEvaluation {
+  const failedNodeIds = sortedUnique(run.nodes
+    .filter((item) => item.state === 'failed' || item.state === 'interrupted')
+    .map((item) => item.nodeId));
+  const blockedNodeIds = sortedUnique(run.nodes
+    .filter((item) => item.state === 'blocked')
+    .map((item) => item.nodeId));
+  const activeNodeIds = sortedUnique(run.nodes
+    .filter((item) => item.state === 'queued' || item.state === 'ready' || item.state === 'running')
+    .map((item) => item.nodeId));
+  const missingEvidenceNodeIds = sortedUnique(run.evidence.nodes
+    .filter((item) => item.processState === 'succeeded'
+      && item.evidenceState !== 'verified')
+    .map((item) => item.nodeId));
+  const repairNodeIds = sortedUnique([...failedNodeIds, ...missingEvidenceNodeIds]);
+  if (repairNodeIds.length > 0) {
+    return {
+      status: 'repair_required', failedNodeIds, blockedNodeIds, activeNodeIds, missingEvidenceNodeIds,
+      nextAction: { kind: 'REPAIR_RETRY', nodeIds: repairNodeIds },
+    };
+  }
+  if (activeNodeIds.length > 0) {
+    return {
+      status: 'active', failedNodeIds, blockedNodeIds, activeNodeIds, missingEvidenceNodeIds,
+      nextAction: { kind: 'WAIT', nodeIds: activeNodeIds },
+    };
+  }
+  if (blockedNodeIds.length > 0) {
+    return {
+      status: 'blocked', failedNodeIds, blockedNodeIds, activeNodeIds, missingEvidenceNodeIds,
+      nextAction: { kind: 'BLOCKED', nodeIds: blockedNodeIds },
+    };
+  }
+  if (run.evidence.verification !== 'verified') {
+    const succeeded = sortedUnique(run.nodes.filter((item) => item.state === 'succeeded').map((item) => item.nodeId));
+    return {
+      status: 'verification_pending', failedNodeIds, blockedNodeIds, activeNodeIds, missingEvidenceNodeIds,
+      nextAction: { kind: 'VERIFY', nodeIds: succeeded },
+    };
+  }
+  return {
+    status: 'verified', failedNodeIds, blockedNodeIds, activeNodeIds, missingEvidenceNodeIds,
+    nextAction: { kind: 'NONE', nodeIds: [] },
+  };
+}
+export class CraftingExecutionController {
+  constructor(private readonly backend: CraftingExecutionBackend) {}
+
+  async start(
+    scope: ExecutionScope,
+    plan: CraftPlan,
+    step: CraftingExecutionStep,
+  ): Promise<CraftingExecutionObservation> {
+    if (plan.status !== 'ready') throw new Error('Crafting execution requires a ready craft plan');
+    const metadata = {
+      crafting: {
+        craftingId: plan.craftingId,
+        craftPlanId: plan.craftPlanId,
+        stepId: step.stepId,
+        ...(step.sparepartId ? { sparepartId: step.sparepartId } : {}),
+        ...(step.compatibilityBoundary ? { compatibilityBoundary: step.compatibilityBoundary } : {}),
+      },
+    };
+    const created = await this.backend.create(scope, {
+      objective: step.purpose,
+      nodes: [{
+        id: step.stepId,
+        purpose: step.purpose,
+        command: step.command,
+        cwd: step.cwd,
+        ...(step.dependsOn ? { dependsOn: [...step.dependsOn] } : {}),
+        ...(step.timeoutMs !== undefined ? { timeoutMs: step.timeoutMs } : {}),
+        ...(step.continueOnFailure !== undefined ? { continueOnFailure: step.continueOnFailure } : {}),
+        ...(step.expectedArtifacts ? { expectedArtifacts: structuredClone(step.expectedArtifacts) } : {}),
+      }],
+      metadata,
+    });
+    const started = await this.backend.start(scope, created.runId);
+    return this.observeView(scope, started);
+  }
+  async startDag(
+    scope: ExecutionScope,
+    plan: CraftPlan,
+    request: CraftingExecutionDagRequest,
+  ): Promise<CraftingExecutionObservation> {
+    if (plan.status !== 'ready') throw new Error('Crafting execution requires a ready craft plan');
+    if (!request.steps.length) throw new Error('Crafting execution DAG requires at least one step');
+    const stepCorrelations = request.steps.map((step) => ({
+      stepId: step.stepId,
+      ...(step.sparepartId ? { sparepartId: step.sparepartId } : {}),
+      ...(step.compatibilityBoundary ? { compatibilityBoundary: step.compatibilityBoundary } : {}),
+    }));
+    const nodes = request.steps.map((step) => ({
+      id: step.stepId,
+      purpose: step.purpose,
+      command: step.command,
+      cwd: step.cwd,
+      ...(step.dependsOn ? { dependsOn: [...step.dependsOn] } : {}),
+      ...(step.timeoutMs !== undefined ? { timeoutMs: step.timeoutMs } : {}),
+      ...(step.continueOnFailure !== undefined ? { continueOnFailure: step.continueOnFailure } : {}),
+      ...(step.expectedArtifacts ? { expectedArtifacts: structuredClone(step.expectedArtifacts) } : {}),
+    }));
+    const created = await this.backend.create(scope, {
+      objective: request.objective,
+      nodes,
+      ...(request.maxConcurrency !== undefined ? { maxConcurrency: request.maxConcurrency } : {}),
+      ...(request.continuityTaskId ? { continuityTaskId: request.continuityTaskId } : {}),
+      ...(request.originRouteContextId ? { originRouteContextId: request.originRouteContextId } : {}),
+      metadata: {
+        crafting: {
+          craftingId: plan.craftingId,
+          craftPlanId: plan.craftPlanId,
+          steps: stepCorrelations,
+        },
+      },
+    });
+    const started = await this.backend.start(scope, created.runId);
+    return this.observeView(scope, started);
+  }
+  async observe(
+    scope: ExecutionScope,
+    _plan: CraftPlan,
+    runId: string,
+  ): Promise<CraftingExecutionObservation> {
+    const run = await this.backend.status(scope, runId);
+    if (!run) throw new Error(`Crafting execution run was not found: ${runId}`);
+    return this.observeView(scope, run);
+  }
+
+  async retry(
+    scope: ExecutionScope,
+    _plan: CraftPlan,
+    runId: string,
+    nodeId: string,
+  ): Promise<CraftingExecutionObservation> {
+    const run = await this.backend.retry(scope, runId, nodeId);
+    return this.observeView(scope, run);
+  }
+
+  private async observeView(
+    scope: ExecutionScope,
+    run: ExecutionRunView,
+  ): Promise<CraftingExecutionObservation> {
+    const attempts = await this.backend.attempts(scope, run.runId);
+    const evaluation = evaluateCraftingExecution(run, attempts);
+    return {
+      ...evaluation,
+      run,
+      attempts,
+    };
+  }
+}
diff --git a/src/crafting/feature-anatomy.ts b/src/crafting/feature-anatomy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b2272d144c3e19c39c3d54585a808dceeda657b0
--- /dev/null
+++ b/src/crafting/feature-anatomy.ts
@@ -0,0 +1,180 @@
+import { createHash } from 'node:crypto';
+import type { SourceGroundingReceipt } from './source-grounding.js';
+import { EvidenceLedger, EvidenceLedgerError } from './evidence-ledger.js';
+
+export type SparepartRelation =
+  | 'DEFINES'
+  | 'CALLS'
+  | 'IMPORTS'
+  | 'IMPLEMENTS'
+  | 'CONFIGURES'
+  | 'READS_STATE'
+  | 'WRITES_STATE'
+  | 'STARTS'
+  | 'STOPS'
+  | 'TESTS'
+  | 'OWNS';
+
+export interface FeatureSparepart {
+  sparepartId: string;
+  referenceId: string;
+  sourcePath: string;
+  symbol?: string;
+  role: string;
+  evidenceRefs: string[];
+}
+
+export interface FeatureConnection {
+  from: string;
+  to: string;
+  relation: SparepartRelation;
+  evidenceRefs: string[];
+}
+export interface FeatureCoverageDecision {
+  evidenceId: string;
+  status: 'unknown' | 'not_required';
+  reason: string;
+}
+
+export interface FeatureAnatomy {
+  anatomyId: string;
+  groundingReceiptId: string;
+  spareparts: FeatureSparepart[];
+  connections: FeatureConnection[];
+  unknownEvidence: string[];
+  notRequiredEvidence: string[];
+  status: 'ready' | 'blocked';
+}
+
+export interface FeatureAnatomyLimits {
+  maxSpareparts: number;
+  maxConnections: number;
+}
+
+export class FeatureAnatomyError extends Error {
+  constructor(readonly code: string, message: string) {
+    super(message);
+    this.name = 'FeatureAnatomyError';
+  }
+}
+
+const DEFAULT_LIMITS: FeatureAnatomyLimits = { maxSpareparts: 500, maxConnections: 2_000 };
+function stableJson(value: unknown): string {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return `[${value.map(stableJson).join(',')}]`;
+  return `{${Object.entries(value as Record<string, unknown>)
+    .sort(([left], [right]) => left.localeCompare(right))
+    .map(([key, item]) => `${JSON.stringify(key)}:${stableJson(item)}`)
+    .join(',')}}`;
+}
+
+function normalizeRefs(refs: string[]): string[] {
+  return [...new Set(refs.map((item) => item.trim()).filter(Boolean))].sort();
+}
+
+function sparepartKey(item: FeatureSparepart): string {
+  return item.sparepartId.trim();
+}
+
+function connectionKey(item: FeatureConnection): string {
+  return [item.from, item.to, item.relation, ...normalizeRefs(item.evidenceRefs)].join('\u0000');
+}
+
+function normalizeSparepart(item: FeatureSparepart, ledger: EvidenceLedger): FeatureSparepart {
+  const sparepartId = item.sparepartId.trim();
+  const referenceId = item.referenceId.trim();
+  const sourcePath = item.sourcePath.replace(/\\/g, '/').trim();
+  const role = item.role.trim();
+  const evidenceRefs = normalizeRefs(item.evidenceRefs);
+  if (!sparepartId || !referenceId || !sourcePath || !role) {
+    throw new FeatureAnatomyError('SPAREPART_INVALID', 'Feature spareparts require id, reference, path, and role');
+  }
+  ledger.require(evidenceRefs, `Sparepart ${sparepartId}`);
+  return {
+    sparepartId,
+    referenceId,
+    sourcePath,
+    ...(item.symbol?.trim() ? { symbol: item.symbol.trim() } : {}),
+    role,
+    evidenceRefs,
+  };
+}
+
+export function buildFeatureAnatomy(input: {
+  receipt: SourceGroundingReceipt;
+  spareparts: FeatureSparepart[];
+  connections: FeatureConnection[];
+  coverage: FeatureCoverageDecision[];
+  limits?: Partial<FeatureAnatomyLimits>;
+}): FeatureAnatomy {
+  if (input.receipt.completeness !== 'sufficient') {
+    throw new FeatureAnatomyError('GROUNDING_INSUFFICIENT', 'Feature anatomy requires sufficient source grounding');
+  }
+  const limits = { ...DEFAULT_LIMITS, ...input.limits };
+  if (input.spareparts.length > limits.maxSpareparts || input.connections.length > limits.maxConnections) {
+    throw new FeatureAnatomyError('ANATOMY_BOUNDS_EXCEEDED', 'Feature anatomy exceeded bounded analysis limits');
+  }
+  const ledger = new EvidenceLedger(input.receipt);
+  let spareparts: FeatureSparepart[];
+  try {
+    spareparts = input.spareparts.map((item) => normalizeSparepart(item, ledger))
+      .sort((left, right) => sparepartKey(left).localeCompare(sparepartKey(right)));
+  } catch (error) {
+    if (error instanceof EvidenceLedgerError) throw new FeatureAnatomyError('EVIDENCE_UNKNOWN', error.message);
+    throw error;
+  }
+  const ids = new Set<string>();
+  for (const item of spareparts) {
+    if (ids.has(item.sparepartId)) throw new FeatureAnatomyError('SPAREPART_DUPLICATE', `Duplicate sparepart: ${item.sparepartId}`);
+    ids.add(item.sparepartId);
+  }
+
+  const connections = input.connections.map((item) => {
+    if (!ids.has(item.from) || !ids.has(item.to)) {
+      throw new FeatureAnatomyError('CONNECTION_NODE_UNKNOWN', `Connection references unknown sparepart: ${item.from} -> ${item.to}`);
+    }
+    const evidenceRefs = normalizeRefs(item.evidenceRefs);
+    try { ledger.require(evidenceRefs, `Connection ${item.from} -> ${item.to}`); }
+    catch (error) {
+      if (error instanceof EvidenceLedgerError) throw new FeatureAnatomyError('EVIDENCE_UNKNOWN', error.message);
+      throw error;
+    }
+    return { from: item.from, to: item.to, relation: item.relation, evidenceRefs };
+  }).sort((left, right) => connectionKey(left).localeCompare(connectionKey(right)));
+
+  const selectedEvidence = new Set(spareparts.flatMap((item) => item.evidenceRefs));
+  const coverage = [...input.coverage]
+    .map((item) => ({ evidenceId: item.evidenceId.trim(), status: item.status, reason: item.reason.trim() }))
+    .sort((left, right) => left.evidenceId.localeCompare(right.evidenceId));
+  const coverageIds = new Set<string>();
+  for (const item of coverage) {
+    if (!item.evidenceId || !item.reason) throw new FeatureAnatomyError('COVERAGE_INVALID', 'Coverage decisions require evidenceId and reason');
+    if (!ledger.has(item.evidenceId)) throw new FeatureAnatomyError('EVIDENCE_UNKNOWN', `Coverage cites unknown evidence: ${item.evidenceId}`);
+    if (selectedEvidence.has(item.evidenceId)) throw new FeatureAnatomyError('COVERAGE_CONFLICT', `Selected evidence cannot also be ${item.status}: ${item.evidenceId}`);
+    if (coverageIds.has(item.evidenceId)) throw new FeatureAnatomyError('COVERAGE_DUPLICATE', `Duplicate coverage decision: ${item.evidenceId}`);
+    coverageIds.add(item.evidenceId);
+  }
+
+  const unaccounted = ledger.ids().filter((id) => !selectedEvidence.has(id) && !coverageIds.has(id));
+  if (unaccounted.length > 0) {
+    throw new FeatureAnatomyError('EVIDENCE_UNACCOUNTED', `Grounding evidence is not represented in anatomy: ${unaccounted.join(', ')}`);
+  }
+  const unknownEvidence = coverage.filter((item) => item.status === 'unknown').map((item) => item.evidenceId);
+  const notRequiredEvidence = coverage.filter((item) => item.status === 'not_required').map((item) => item.evidenceId);
+  const identity = {
+    groundingReceiptId: input.receipt.receiptId,
+    spareparts,
+    connections,
+    coverage,
+  };
+  const anatomyId = `anatomy:${createHash('sha256').update(stableJson(identity), 'utf8').digest('hex').slice(0, 32)}`;
+  return {
+    anatomyId,
+    groundingReceiptId: input.receipt.receiptId,
+    spareparts,
+    connections,
+    unknownEvidence,
+    notRequiredEvidence,
+    status: unknownEvidence.length > 0 ? 'blocked' : 'ready',
+  };
+}
diff --git a/src/crafting/mode-resolver.ts b/src/crafting/mode-resolver.ts
new file mode 100644
index 0000000000000000000000000000000000000000..68c9411dca0835af5d50cf3aedf8eb3e2022a48a
--- /dev/null
+++ b/src/crafting/mode-resolver.ts
@@ -0,0 +1,170 @@
+import { createHash } from 'node:crypto';
+import type {
+  CraftingFeatureContract,
+  CraftingMode,
+  CraftingModeDecision,
+  CraftingReasonCode,
+  CraftingReference,
+  ResolveCraftingModeRequest,
+} from './types.js';
+
+export type {
+  CraftingFeatureContract,
+  CraftingMode,
+  CraftingModeDecision,
+  CraftingReference,
+  ResolveCraftingModeRequest,
+} from './types.js';
+
+export class CraftingModeResolutionError extends Error {
+  constructor(readonly code: CraftingReasonCode, message: string) {
+    super(message);
+    this.name = 'CraftingModeResolutionError';
+  }
+}
+
+function stableJson(value: unknown): string {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return `[${value.map(stableJson).join(',')}]`;
+  return `{${Object.entries(value as Record<string, unknown>)
+    .sort(([left], [right]) => left.localeCompare(right))
+    .map(([key, item]) => `${JSON.stringify(key)}:${stableJson(item)}`)
+    .join(',')}}`;
+}
+
+function sha256(value: unknown): string {
+  return createHash('sha256').update(stableJson(value), 'utf8').digest('hex');
+}
+
+function text(value: string | undefined): string | undefined {
+  const normalized = value?.trim();
+  return normalized ? normalized : undefined;
+}
+
+function immutableHash(value: string | undefined, label: string): string {
+  const normalized = text(value)?.toLowerCase();
+  if (!normalized || !/^[0-9a-f]{40,64}$/.test(normalized)) {
+    throw new CraftingModeResolutionError(
+      'REFERENCE_AMBIGUOUS',
+      `${label} must be an immutable Git/hash identity`,
+    );
+  }
+  return normalized;
+}
+
+function normalizedTextList(values: string[]): string[] {
+  return [...new Set(values.map((value) => value.trim()).filter(Boolean))].sort();
+}
+function normalizeFeature(feature: CraftingFeatureContract): CraftingFeatureContract {
+  const featureId = text(feature.featureId);
+  const title = text(feature.title);
+  const objective = text(feature.objective);
+  const planFingerprint = text(feature.planFingerprint)?.toLowerCase();
+  if (!featureId || !title || !objective || !planFingerprint || !/^[0-9a-f]{64}$/.test(planFingerprint)) {
+    throw new Error('Crafting feature requires featureId, title, objective, and 64-char planFingerprint');
+  }
+  return {
+    featureId,
+    title,
+    objective,
+    requiredBehaviors: normalizedTextList(feature.requiredBehaviors),
+    requiredInvariants: normalizedTextList(feature.requiredInvariants),
+    explicitNonGoals: normalizedTextList(feature.explicitNonGoals),
+    targetAuthorities: normalizedTextList(feature.targetAuthorities),
+    verificationRequirements: normalizedTextList(feature.verificationRequirements),
+    ...(feature.targetPaths ? { targetPaths: normalizedTextList(feature.targetPaths) } : {}),
+    planFingerprint,
+  };
+}
+
+function normalizeReference(reference: CraftingReference): CraftingReference {
+  const referenceId = text(reference.referenceId);
+  const featureScope = text(reference.featureScope);
+  const approvalSource = text(reference.approvalSource);
+  if (!referenceId || !featureScope || !approvalSource) {
+    throw new CraftingModeResolutionError('REFERENCE_AMBIGUOUS', 'Approved reference metadata is incomplete');
+  }
+  const availability = reference.availability ?? 'available';
+  if (availability === 'unavailable') {
+    throw new CraftingModeResolutionError('REFERENCE_UNAVAILABLE', `Reference ${referenceId} is unavailable`);
+  }
+  if (availability === 'ambiguous') {
+    throw new CraftingModeResolutionError('REFERENCE_AMBIGUOUS', `Reference ${referenceId} is ambiguous`);
+  }
+  const base = {
+    referenceId,
+    kind: reference.kind,
+    featureScope,
+    approvalSource,
+    availability: 'available' as const,
+    required: reference.required === true,
+  };
+  if (reference.kind === 'git_repo') {
+    const repository = text(reference.repository);
+    if (!repository) throw new CraftingModeResolutionError('REFERENCE_AMBIGUOUS', `${referenceId} has no repository`);
+    return {
+      ...base,
+      repository,
+      commit: immutableHash(reference.commit, `${referenceId}.commit`),
+      tree: immutableHash(reference.tree, `${referenceId}.tree`),
+    };
+  }
+  if (reference.kind === 'source_bundle') {
+    return { ...base, bundleHash: immutableHash(reference.bundleHash, `${referenceId}.bundleHash`) };
+  }
+  const localPath = text(reference.localPath);
+  if (!localPath) throw new CraftingModeResolutionError('REFERENCE_AMBIGUOUS', `${referenceId} has no localPath`);
+  if (reference.commit || reference.tree) {
+    return {
+      ...base,
+      localPath,
+      commit: immutableHash(reference.commit, `${referenceId}.commit`),
+      tree: immutableHash(reference.tree, `${referenceId}.tree`),
+    };
+  }
+  return { ...base, localPath, bundleHash: immutableHash(reference.bundleHash, `${referenceId}.bundleHash`) };
+}
+
+function normalizeReferences(references: CraftingReference[]): CraftingReference[] {
+  const normalized = references.map(normalizeReference)
+    .sort((left, right) => left.referenceId.localeCompare(right.referenceId));
+  for (let index = 1; index < normalized.length; index += 1) {
+    const previous = normalized[index - 1];
+    const current = normalized[index];
+    if (previous && current && previous.referenceId === current.referenceId) {
+      throw new CraftingModeResolutionError('REFERENCE_AMBIGUOUS', `Duplicate referenceId: ${current.referenceId}`);
+    }
+  }
+  return normalized;
+}
+
+export function resolveCraftingMode(request: ResolveCraftingModeRequest): CraftingModeDecision {
+  const routeContextId = text(request.routeContextId);
+  const projectId = text(request.projectId);
+  if (!routeContextId || !projectId) throw new Error('Crafting mode requires routeContextId and projectId');
+  const feature = normalizeFeature(request.feature);
+  const references = normalizeReferences(request.references ?? []);
+  if (references.length === 0 && request.referencePolicy === 'required') {
+    throw new CraftingModeResolutionError('REFERENCE_REQUIRED', 'The task requires an approved implementation reference');
+  }
+  const mode: CraftingMode = references.length === 0 ? 'BUILD_FROM_ZERO' : 'FEATURE_TRANSPLANTATION';
+  const reasonCodes: CraftingReasonCode[] = mode === 'BUILD_FROM_ZERO'
+    ? ['NO_APPROVED_REFERENCE']
+    : ['APPROVED_REFERENCE_PRESENT'];
+  if (references.length > 1) reasonCodes.push('MULTIPLE_APPROVED_REFERENCES');
+  const featureContractHash = sha256(feature);
+  const referenceSetHash = sha256(references);
+  // Crafting identity represents the durable coding objective, not a single route/session.
+  // Route context is intentionally excluded so resumed sessions can obtain fresh leases.
+  const craftingHash = sha256({ projectId, mode, featureContractHash, referenceSetHash });
+  return {
+    craftingId: `craft:${craftingHash.slice(0, 32)}`,
+    routeContextId,
+    projectId,
+    mode,
+    featureContractHash,
+    references,
+    referenceSetHash,
+    reasonCodes,
+  };
+}
diff --git a/src/crafting/mutation-intent.ts b/src/crafting/mutation-intent.ts
new file mode 100644
index 0000000000000000000000000000000000000000..816732f92f17979e9fed6aebdb0824363de791a1
--- /dev/null
+++ b/src/crafting/mutation-intent.ts
@@ -0,0 +1,117 @@
+export type CraftingMutationClass = 'none' | 'source_mutation' | 'verification_command';
+
+export interface CraftingMutationClassification {
+  required: boolean;
+  mutationClass: CraftingMutationClass;
+  reasonCode:
+    | 'READ_ONLY_OPERATION'
+    | 'DOCUMENTATION_ONLY'
+    | 'CODING_PATH_MUTATION'
+    | 'CODING_VERIFICATION_COMMAND'
+    | 'NON_CODING_OPERATION';
+}
+
+export type CraftingMutationOrigin =
+  | 'host_original'
+  | 'donor_derived'
+  | 'compatibility'
+  | 'verification';
+
+export interface CraftingMutationIntent {
+  origin: CraftingMutationOrigin;
+  sparepartId?: string;
+  compatibilityBoundary?: string;
+}
+
+const SOURCE_EXTENSIONS = new Set([
+  '.ts', '.tsx', '.js', '.jsx', '.mjs', '.cjs', '.mts', '.cts',
+  '.py', '.go', '.rs', '.java', '.kt', '.kts', '.c', '.cc', '.cpp', '.h', '.hpp',
+  '.cs', '.php', '.rb', '.swift', '.scala', '.ex', '.exs', '.clj', '.cljs', '.lua',
+  '.dart', '.sol', '.nix', '.sh', '.ps1', '.bat', '.cmd',
+]);
+const CONFIG_BASENAMES = new Set([
+  'package.json', 'package-lock.json', 'pnpm-lock.yaml', 'yarn.lock',
+  'tsconfig.json', 'vitest.config.ts', 'vite.config.ts', 'eslint.config.js',
+  'pyproject.toml', 'cargo.toml', 'cargo.lock', 'go.mod', 'go.sum',
+  'dockerfile', 'makefile', 'pom.xml', 'build.gradle', 'build.gradle.kts',
+]);
+
+const VERIFICATION_COMMAND = /\b(?:npm|pnpm|yarn|bun)\s+(?:test|run\s+(?:test|build|lint|typecheck|verify))\b|\b(?:vitest|jest|pytest|tsc|cargo\s+test|go\s+test|mvn\s+test|gradle\s+test)\b/i;
+
+function normalizedPath(value: string): string {
+  return value.replace(/\\/g, '/').toLowerCase();
+}
+function basename(value: string): string {
+  const normalized = normalizedPath(value);
+  return normalized.slice(normalized.lastIndexOf('/') + 1);
+}
+function extension(value: string): string {
+  const name = basename(value);
+  const index = name.lastIndexOf('.');
+  return index > 0 ? name.slice(index) : '';
+}
+function documentationPath(value: string): boolean {
+  const normalized = normalizedPath(value);
+  return /(?:^|\/)docs?\//.test(normalized) && /\.(?:md|mdx|txt)$/.test(normalized);
+}
+function codingPath(value: string): boolean {
+  const normalized = normalizedPath(value);
+  if (documentationPath(value)) return false;
+  if (/(?:^|\/)(?:src|source|lib|app|apps|packages|plugin|plugins|test|tests|__tests__|config)(?:\/|$)/.test(normalized)) return true;
+  if (SOURCE_EXTENSIONS.has(extension(value))) return true;
+  return CONFIG_BASENAMES.has(basename(value));
+}
+function affectedPaths(input: Record<string, unknown>): string[] {
+  const values = [input.path, input.source, input.destination]
+    .filter((value): value is string => typeof value === 'string');
+  if (Array.isArray(input.paths)) values.push(...input.paths.filter((value): value is string => typeof value === 'string'));
+  return values;
+}
+
+export function classifyCraftingMutation(
+  toolName: string,
+  input: Record<string, unknown> = {},
+): CraftingMutationClassification {
+  if (toolName === 'read_file' || toolName === 'read_multiple_files'
+    || toolName === 'list_directory' || toolName === 'get_file_info' || toolName === 'search_files') {
+    return { required: false, mutationClass: 'none', reasonCode: 'READ_ONLY_OPERATION' };
+  }
+  if (toolName === 'execute_command' || toolName === 'start_process') {
+    const command = typeof input.command === 'string' ? input.command : '';
+    if (VERIFICATION_COMMAND.test(command)) {
+      return { required: true, mutationClass: 'verification_command', reasonCode: 'CODING_VERIFICATION_COMMAND' };
+    }
+    return { required: false, mutationClass: 'none', reasonCode: 'NON_CODING_OPERATION' };
+  }
+  if (toolName === 'write_file' || toolName === 'edit_file'
+    || toolName === 'create_directory' || toolName === 'move_file') {
+    const paths = affectedPaths(input);
+    if (paths.length > 0 && paths.every(documentationPath)) {
+      return { required: false, mutationClass: 'none', reasonCode: 'DOCUMENTATION_ONLY' };
+    }
+    if (paths.some(codingPath)) {
+      return { required: true, mutationClass: 'source_mutation', reasonCode: 'CODING_PATH_MUTATION' };
+    }
+  }
+  return { required: false, mutationClass: 'none', reasonCode: 'NON_CODING_OPERATION' };
+}
+export function parseCraftingMutationIntent(input: Record<string, unknown>): CraftingMutationIntent | undefined {
+  const raw = input.craftingIntent;
+  if (raw === undefined) return undefined;
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) throw new Error('craftingIntent must be an object');
+  const value = raw as Record<string, unknown>;
+  const origin = value.origin;
+  if (origin !== 'host_original' && origin !== 'donor_derived'
+    && origin !== 'compatibility' && origin !== 'verification') {
+    throw new Error('craftingIntent.origin is invalid');
+  }
+  const sparepartId = typeof value.sparepartId === 'string' ? value.sparepartId.trim() : '';
+  const compatibilityBoundary = typeof value.compatibilityBoundary === 'string'
+    ? value.compatibilityBoundary.trim()
+    : '';
+  return {
+    origin,
+    ...(sparepartId ? { sparepartId } : {}),
+    ...(compatibilityBoundary ? { compatibilityBoundary } : {}),
+  };
+}
diff --git a/src/crafting/reference-resolution.ts b/src/crafting/reference-resolution.ts
new file mode 100644
index 0000000000000000000000000000000000000000..328be6e42f49bdead0c3ddde32fc2acdeaaa5765
--- /dev/null
+++ b/src/crafting/reference-resolution.ts
@@ -0,0 +1,50 @@
+import { createHash } from 'node:crypto';
+import path from 'node:path';
+import type { WorkspacePolicy } from '../runtime/workspace.js';
+import type { CraftingReference } from './types.js';
+
+export interface ResolvedCraftingReference {
+  referenceId: string;
+  localRoot: string;
+  identityHash: string;
+  reference: CraftingReference;
+}
+
+function stableJson(value: unknown): string {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return `[${value.map(stableJson).join(',')}]`;
+  return `{${Object.entries(value as Record<string, unknown>)
+    .sort(([left], [right]) => left.localeCompare(right))
+    .map(([key, item]) => `${JSON.stringify(key)}:${stableJson(item)}`)
+    .join(',')}}`;
+}
+
+export function craftingReferenceIdentityHash(reference: CraftingReference): string {
+  const identity = reference.kind === 'git_repo'
+    ? { kind: reference.kind, repository: reference.repository, commit: reference.commit, tree: reference.tree }
+    : reference.commit || reference.tree
+      ? { kind: reference.kind, commit: reference.commit, tree: reference.tree }
+      : { kind: reference.kind, bundleHash: reference.bundleHash };
+  return createHash('sha256').update(stableJson(identity), 'utf8').digest('hex');
+}
+export async function resolveReferenceSource(
+  reference: CraftingReference,
+  localPath: string,
+  workspace: WorkspacePolicy,
+): Promise<ResolvedCraftingReference> {
+  const localRoot = await workspace.resolveExisting(localPath);
+  if (reference.kind === 'local_repo' && reference.localPath) {
+    const declared = path.resolve(reference.localPath);
+    const actual = path.resolve(localRoot);
+    const normalize = (value: string) => process.platform === 'win32' ? value.toLowerCase() : value;
+    if (normalize(declared) !== normalize(actual)) {
+      throw new Error(`Resolved local reference path does not match locked reference: ${reference.referenceId}`);
+    }
+  }
+  return {
+    referenceId: reference.referenceId,
+    localRoot,
+    identityHash: craftingReferenceIdentityHash(reference),
+    reference: structuredClone(reference),
+  };
+}
diff --git a/src/crafting/service.ts b/src/crafting/service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..57254f347929df52c8ddfaa526846f5b8eaeb9eb
--- /dev/null
+++ b/src/crafting/service.ts
@@ -0,0 +1,175 @@
+import { randomUUID } from 'node:crypto';
+import type { CraftingConfig } from '../config.js';
+import type { CraftPlan } from './craft-plan.js';
+import type { CompatibilityBinding } from './compatibility-surgery.js';
+import type { CraftingModeDecision } from './types.js';
+import type { RouteCraftingProjection } from '../runtime/route-context-store.js';
+
+export type CraftingErrorCode =
+  | 'CRAFTING_REQUIRED'
+  | 'CRAFTING_STATE_INVALID'
+  | 'CRAFTING_LEASE_INVALID'
+  | 'CRAFTING_STALE'
+  | 'CRAFT_PLAN_REQUIRED'
+  | 'SOURCE_GROUNDING_REQUIRED'
+  | 'BUILD_FROM_ZERO_DONOR_EVIDENCE_FORBIDDEN'
+  | 'CRAFT_MUTATION_MAPPING_REQUIRED'
+  | 'CLEAN_ROOM_PARALLEL_IMPLEMENTATION'
+  | 'CRAFT_MUTATION_NOT_ALLOWED'
+  | 'CRAFT_MUTATION_PATH_MISMATCH'
+  | 'CRAFT_COMPATIBILITY_MAPPING_REQUIRED';
+
+export class CraftingError extends Error {
+  constructor(
+    readonly code: CraftingErrorCode,
+    message: string,
+    readonly details?: Record<string, unknown>,
+  ) {
+    super(message);
+    this.name = 'CraftingError';
+  }
+}
+
+export interface RegisteredCraftPlan extends CraftPlan {
+  compatibilityBindings?: CompatibilityBinding[];
+}
+export interface CraftingLease {
+  leaseId: string;
+  principalId: string;
+  projectId?: string;
+  routeContextId: string;
+  craftingId: string;
+  mode: RouteCraftingProjection['mode'];
+  featureContractHash: string;
+  referenceSetHash: string;
+  groundingReceiptId?: string;
+  craftPlanId: string;
+  issuedAt: number;
+  expiresAt: number;
+}
+export interface IssueCraftingLeaseRequest {
+  principalId: string;
+  projectId?: string;
+  routeContextId: string;
+  crafting: RouteCraftingProjection;
+  routeExpiresAt: number;
+}
+
+export interface ValidateCraftingLeaseRequest {
+  principalId: string;
+  projectId?: string;
+  routeContextId: string;
+  crafting: RouteCraftingProjection;
+}
+
+function scopeEqual(left: string | undefined, right: string | undefined): boolean {
+  return (left ?? '') === (right ?? '');
+}
+
+export class CraftingService {
+  readonly config: CraftingConfig;
+  private readonly leases = new Map<string, CraftingLease>();
+  private readonly craftPlans = new Map<string, RegisteredCraftPlan>();
+  private readonly decisions = new Map<string, CraftingModeDecision>();
+
+  constructor(config: CraftingConfig, private readonly now: () => number = Date.now) {
+    this.config = { ...config };
+  }
+  registerDecision(decision: CraftingModeDecision): CraftingModeDecision {
+    const existing = this.decisions.get(decision.craftingId);
+    if (existing) {
+      const { routeContextId: _existingRoute, ...existingIdentity } = existing;
+      const { routeContextId: _nextRoute, ...nextIdentity } = decision;
+      if (JSON.stringify(existingIdentity) !== JSON.stringify(nextIdentity)) {
+        throw new CraftingError('CRAFTING_STALE', `Crafting decision identity collision: ${decision.craftingId}`);
+      }
+    }
+    const clone = structuredClone(decision);
+    this.decisions.set(decision.craftingId, clone);
+    return structuredClone(clone);
+  }
+
+  getDecision(craftingId: string): CraftingModeDecision | null {
+    const decision = this.decisions.get(craftingId);
+    return decision ? structuredClone(decision) : null;
+  }
+  registerCraftPlan(plan: RegisteredCraftPlan): RegisteredCraftPlan {
+    if (!plan.craftPlanId || !plan.craftingId || plan.status !== 'ready') {
+      throw new CraftingError('CRAFT_PLAN_REQUIRED', 'Only identity-complete ready craft plans may be registered');
+    }
+    const existing = this.craftPlans.get(plan.craftPlanId);
+    if (existing && JSON.stringify(existing) !== JSON.stringify(plan)) {
+      throw new CraftingError('CRAFTING_STALE', `Craft plan identity collision: ${plan.craftPlanId}`);
+    }
+    const clone = structuredClone(plan);
+    this.craftPlans.set(plan.craftPlanId, clone);
+    return structuredClone(clone);
+  }
+
+  getCraftPlan(craftPlanId: string): RegisteredCraftPlan | null {
+    const plan = this.craftPlans.get(craftPlanId);
+    return plan ? structuredClone(plan) : null;
+  }
+
+  issueLease(request: IssueCraftingLeaseRequest): CraftingLease {
+    const now = this.now();
+    if (request.crafting.state !== 'ready') {
+      throw new CraftingError('CRAFTING_STATE_INVALID', `Crafting lease requires ready state, received ${request.crafting.state}`);
+    }
+    if (!request.crafting.craftPlanId) {
+      throw new CraftingError('CRAFT_PLAN_REQUIRED', 'Meaningful coding mutation requires a ready craft plan');
+    }
+    if (request.crafting.mode === 'FEATURE_TRANSPLANTATION' && !request.crafting.groundingReceiptId) {
+      throw new CraftingError('SOURCE_GROUNDING_REQUIRED', 'FEATURE_TRANSPLANTATION requires sufficient source grounding before lease issuance');
+    }
+    if (!Number.isFinite(request.routeExpiresAt) || request.routeExpiresAt <= now) {
+      throw new CraftingError('CRAFTING_LEASE_INVALID', 'Route expiry must be in the future for crafting lease issuance');
+    }
+    const lease: CraftingLease = {
+      leaseId: randomUUID(),
+      principalId: request.principalId,
+      ...(request.projectId ? { projectId: request.projectId } : {}),
+      routeContextId: request.routeContextId,
+      craftingId: request.crafting.craftingId,
+      mode: request.crafting.mode,
+      featureContractHash: request.crafting.featureContractHash,
+      referenceSetHash: request.crafting.referenceSetHash,
+      ...(request.crafting.groundingReceiptId ? { groundingReceiptId: request.crafting.groundingReceiptId } : {}),
+      craftPlanId: request.crafting.craftPlanId,
+      issuedAt: now,
+      expiresAt: Math.min(request.routeExpiresAt, now + this.config.leaseTtlMs),
+    };
+    this.leases.set(lease.leaseId, lease);
+    return structuredClone(lease);
+  }
+
+  validateLease(request: ValidateCraftingLeaseRequest): CraftingLease {
+    const leaseId = request.crafting.leaseId;
+    if (!leaseId) throw new CraftingError('CRAFTING_REQUIRED', 'Meaningful coding work requires a scoped crafting lease');
+    const lease = this.leases.get(leaseId);
+    if (!lease || lease.expiresAt <= this.now()) {
+      if (lease) this.leases.delete(leaseId);
+      throw new CraftingError('CRAFTING_LEASE_INVALID', 'Crafting lease is missing or expired');
+    }
+    if (lease.principalId !== request.principalId
+      || !scopeEqual(lease.projectId, request.projectId)
+      || lease.routeContextId !== request.routeContextId) {
+      throw new CraftingError('CRAFTING_LEASE_INVALID', 'Crafting lease scope does not match the active route');
+    }
+    const stale = lease.craftingId !== request.crafting.craftingId
+      || lease.mode !== request.crafting.mode
+      || lease.featureContractHash !== request.crafting.featureContractHash
+      || lease.referenceSetHash !== request.crafting.referenceSetHash
+      || (lease.groundingReceiptId ?? '') !== (request.crafting.groundingReceiptId ?? '')
+      || lease.craftPlanId !== request.crafting.craftPlanId;
+    if (stale) throw new CraftingError('CRAFTING_STALE', 'Crafting lease no longer matches current feature/reference/grounding/craft-plan identity');
+    if (request.crafting.state === 'analysis' || request.crafting.state === 'closed') {
+      throw new CraftingError('CRAFTING_STATE_INVALID', `Crafting work is not allowed while state is ${request.crafting.state}`);
+    }
+    return structuredClone(lease);
+  }
+
+  revoke(leaseId: string): void {
+    this.leases.delete(leaseId);
+  }
+}
diff --git a/src/crafting/source-grounding.ts b/src/crafting/source-grounding.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bb28b2703bb9157682b7b59a8e4095a0443def98
--- /dev/null
+++ b/src/crafting/source-grounding.ts
@@ -0,0 +1,211 @@
+import { createHash } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import path from 'node:path';
+import type { WorkspacePolicy } from '../runtime/workspace.js';
+import type { CraftingModeDecision } from './types.js';
+import {
+  craftingReferenceIdentityHash,
+  type ResolvedCraftingReference,
+} from './reference-resolution.js';
+
+export type SourceEvidenceRole =
+  | 'entry_point'
+  | 'dependency'
+  | 'state'
+  | 'config'
+  | 'lifecycle'
+  | 'test'
+  | 'interface'
+  | 'error_path';
+
+export interface SourceEvidence {
+  evidenceId: string;
+  referenceId: string;
+  referenceIdentityHash: string;
+  sourcePath: string;
+  symbol?: string;
+  lineStart?: number;
+  lineEnd?: number;
+  contentHash: string;
+  role: SourceEvidenceRole;
+  observation: string;
+}
+export interface SourceGroundingReceipt {
+  receiptId: string;
+  referenceSetHash: string;
+  featureContractHash: string;
+  evidence: SourceEvidence[];
+  inspectedSourceFiles: string[];
+  inspectedTests: string[];
+  completeness: 'sufficient' | 'insufficient';
+  missingEvidence: string[];
+}
+
+export interface GroundingRequirements {
+  tests: boolean;
+  lifecycle: boolean;
+  stateOrConfig: boolean;
+}
+
+export class GroundingError extends Error {
+  constructor(readonly code: string, message: string) {
+    super(message);
+    this.name = 'GroundingError';
+  }
+}
+
+function sha256(value: string): string {
+  return createHash('sha256').update(value, 'utf8').digest('hex');
+}
+
+function normalizeRelative(value: string): string {
+  return value.replace(/\\/g, '/').replace(/^\.\//, '');
+}
+function orientationOnlyPath(sourcePath: string): boolean {
+  const normalized = normalizeRelative(sourcePath).toLowerCase();
+  const base = normalized.slice(normalized.lastIndexOf('/') + 1);
+  if (/^readme(?:\.[^.]+)?$/.test(base)) return true;
+  if (base === 'package.json' || base === 'package-lock.json') return true;
+  return /(^|\/)docs?\//.test(normalized) && /\.(md|mdx|txt)$/.test(normalized);
+}
+
+function withinRoot(root: string, candidate: string): boolean {
+  const relative = path.relative(root, candidate);
+  return relative === '' || (!relative.startsWith('..') && !path.isAbsolute(relative));
+}
+
+export async function inspectSourceEvidence(input: {
+  workspace: WorkspacePolicy;
+  reference: ResolvedCraftingReference;
+  relativePath: string;
+  role: SourceEvidenceRole;
+  observation: string;
+  symbol?: string;
+  lineStart?: number;
+  lineEnd?: number;
+}): Promise<SourceEvidence> {
+  const relativePath = normalizeRelative(input.relativePath);
+  const candidate = path.resolve(input.reference.localRoot, relativePath);
+  if (!withinRoot(input.reference.localRoot, candidate)) {
+    throw new GroundingError('SOURCE_PATH_OUTSIDE_REFERENCE', 'Source evidence must remain inside the resolved reference root');
+  }
+  const resolved = await input.workspace.resolveExisting(candidate);
+  const bytes = await readFile(resolved);
+  const contentHash = createHash('sha256').update(bytes).digest('hex');
+  const observation = input.observation.trim();
+  if (!observation) throw new GroundingError('SOURCE_OBSERVATION_REQUIRED', 'Source evidence requires a bounded factual observation');
+  const identity = {
+    referenceId: input.reference.referenceId,
+    referenceIdentityHash: input.reference.identityHash,
+    sourcePath: relativePath,
+    symbol: input.symbol?.trim() || null,
+    lineStart: input.lineStart ?? null,
+    lineEnd: input.lineEnd ?? null,
+    contentHash,
+    role: input.role,
+    observation,
+  };
+  const evidenceId = `source:${sha256(JSON.stringify(identity))}`;
+  return {
+    evidenceId,
+    referenceId: input.reference.referenceId,
+    referenceIdentityHash: input.reference.identityHash,
+    sourcePath: relativePath,
+    ...(input.symbol?.trim() ? { symbol: input.symbol.trim() } : {}),
+    ...(input.lineStart !== undefined ? { lineStart: input.lineStart } : {}),
+    ...(input.lineEnd !== undefined ? { lineEnd: input.lineEnd } : {}),
+    contentHash,
+    role: input.role,
+    observation,
+  };
+}
+
+function stableEvidence(evidence: SourceEvidence[]): SourceEvidence[] {
+  return [...new Map(evidence.map((item) => [item.evidenceId, structuredClone(item)])).values()]
+    .sort((left, right) => left.evidenceId.localeCompare(right.evidenceId));
+}
+function assertEvidenceMatchesDecision(decision: CraftingModeDecision, evidence: SourceEvidence[]): void {
+  const identities = new Map(decision.references.map((reference) => [
+    reference.referenceId,
+    craftingReferenceIdentityHash(reference),
+  ]));
+  for (const item of evidence) {
+    const expected = identities.get(item.referenceId);
+    if (!expected || expected !== item.referenceIdentityHash) {
+      throw new GroundingError(
+        'REFERENCE_IDENTITY_MISMATCH',
+        `Source evidence no longer matches the locked reference identity: ${item.referenceId}`,
+      );
+    }
+    if (!/^[0-9a-f]{64}$/.test(item.contentHash)) {
+      throw new GroundingError('SOURCE_HASH_INVALID', `Source evidence has invalid content hash: ${item.sourcePath}`);
+    }
+  }
+}
+
+export function buildSourceGroundingReceipt(input: {
+  decision: CraftingModeDecision;
+  evidence: SourceEvidence[];
+  requirements: GroundingRequirements;
+}): SourceGroundingReceipt {
+  if (input.decision.mode !== 'FEATURE_TRANSPLANTATION') {
+    throw new GroundingError('GROUNDING_NOT_ALLOWED', 'BUILD_FROM_ZERO cannot accept donor-derived source grounding');
+  }
+  const evidence = stableEvidence(input.evidence);
+  assertEvidenceMatchesDecision(input.decision, evidence);
+  const actual = evidence.filter((item) => !orientationOnlyPath(item.sourcePath));
+  const missing: string[] = [];
+  if (!actual.some((item) => item.role === 'entry_point')) missing.push('entry_point');
+  if (!actual.some((item) => item.role === 'dependency' || item.role === 'interface')) {
+    missing.push('dependency_or_interface');
+  }
+  if (input.requirements.tests && !actual.some((item) => item.role === 'test')) missing.push('test');
+  if (input.requirements.lifecycle && !actual.some((item) => item.role === 'lifecycle')) missing.push('lifecycle');
+  if (input.requirements.stateOrConfig
+    && !evidence.some((item) => item.role === 'state' || item.role === 'config')) {
+    missing.push('state_or_config');
+  }
+  if (missing.length > 0) {
+    throw new GroundingError(
+      'SOURCE_GROUNDING_INSUFFICIENT',
+      `Source grounding is insufficient: ${missing.join(', ')}`,
+    );
+  }
+  const inspectedTests = [...new Set(actual.filter((item) => item.role === 'test').map((item) => item.sourcePath))].sort();
+  const inspectedSourceFiles = [...new Set(actual
+    .filter((item) => item.role !== 'test')
+    .map((item) => item.sourcePath))].sort();
+  const receiptIdentity = JSON.stringify({
+    referenceSetHash: input.decision.referenceSetHash,
+    featureContractHash: input.decision.featureContractHash,
+    evidence: evidence.map((item) => item.evidenceId),
+    inspectedSourceFiles,
+    inspectedTests,
+  });
+  return {
+    receiptId: `grounding:${sha256(receiptIdentity).slice(0, 32)}`,
+    referenceSetHash: input.decision.referenceSetHash,
+    featureContractHash: input.decision.featureContractHash,
+    evidence,
+    inspectedSourceFiles,
+    inspectedTests,
+    completeness: 'sufficient',
+    missingEvidence: [],
+  };
+}
+
+export function validateGroundingReceipt(
+  decision: CraftingModeDecision,
+  receipt: SourceGroundingReceipt,
+): SourceGroundingReceipt {
+  if (decision.mode !== 'FEATURE_TRANSPLANTATION') {
+    throw new GroundingError('GROUNDING_NOT_ALLOWED', 'Only transplantation mode may validate donor grounding');
+  }
+  if (receipt.completeness !== 'sufficient'
+    || receipt.referenceSetHash !== decision.referenceSetHash
+    || receipt.featureContractHash !== decision.featureContractHash) {
+    throw new GroundingError('GROUNDING_STALE', 'Grounding receipt does not match the locked crafting decision');
+  }
+  assertEvidenceMatchesDecision(decision, receipt.evidence);
+  return structuredClone(receipt);
+}
