+ const store=new FileOAuthStore(root);const tokens=results.flatMap(r=>r.tokens);const valid=await Promise.all(tokens.map(t=>store.verifyAccessToken(t)));
+ expect(valid.filter(Boolean).length).toBe(32);
+},15000);
