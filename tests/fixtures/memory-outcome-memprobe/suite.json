                "value": 101
              },
              {
                "key": "b",
                "sequence": 2,
                "value": 0,
                "deleted": true
              }
            ],
            "expected": [
              {
                "key": "a",
                "value": 101
              }
            ]
          },
          {
            "input": [
              {
                "key": "b",
                "sequence": 2,
                "value": 0,
                "deleted": true
              },
              {
                "key": "a",
                "sequence": 1,
                "value": 101
              },
              {
                "key": "b",
                "sequence": 1,
                "value": 100
              }
            ],
            "expected": [
              {
                "key": "a",
                "value": 101
              }
            ]
          },
          {
            "input": [],
            "expected": []
          },
          {
            "input": [
              {
                "key": "z",
                "sequence": 1,
                "value": 0
              }
            ],
            "expected": [
              {
                "key": "z",
                "value": 0
              }
            ]
          }
        ]
      },
